template sltm_geo_panel
{
    widget = {
        name = "geo_panel" position = { 182 190 } size = { 690 526 }
        visible = "[GetScriptedGui('sltm_tab_geo_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        textbox = {
            name = "geo_heading"
            position = { 0 0 } size = { 673 27 }
            text = "SLTM_TAB_GEO_TITLE" fontsize = 17 font = StandardGameFont
            fontcolor = { 0.88 0.84 0.75 1 } align = left|top
            autoresize = no multiline = yes alwaystransparent = yes
        }
        textbox = {
            name = "geo_intro"
            position = { 0 25 } size = { 675 32 }
            text = "SLTM_TAB_GEO_INTRO" fontsize = 13 font = StandardGameFont
            fontcolor = { 0.68 0.65 0.59 1 } align = left|top
            autoresize = no multiline = yes alwaystransparent = yes
        }
        scrollarea = {
            name = "geo_scroll" position = { 0 60 } size = { 690 464 }
            scrollbarpolicy_horizontal = always_off scrollbarpolicy_vertical = as_needed
            scrollwidget = {
                widget = { name = "geo_body" size = { 667 337 }
                    textbox = {
                        name = "capital_title"
                        position = { 0 0 } size = { 165 26 }
                        text = "SLTM_TAB_CAPITAL_TITLE" fontsize = 16 font = StandardGameFont
                        fontcolor = { 0.88 0.84 0.75 1 } align = left|top
                        autoresize = no multiline = yes alwaystransparent = yes
                    }
                    textbox = {
                        name = "capital_current"
                        position = { 170 0 } size = { 480 27 }
                        text = "SLTM_TAB_CAPITAL_CURRENT" fontsize = 14 font = StandardGameFont
                        fontcolor = { 0.68 0.65 0.59 1 } align = left|top
                        autoresize = no multiline = yes alwaystransparent = yes
                    }
                    textbox = {
                        name = "capital_hint"
                        position = { 0 32 } size = { 650 28 }
                        text = "SLTM_TAB_CAPITAL_NOTE" fontsize = 13 font = StandardGameFont
                        fontcolor = { 0.68 0.65 0.59 1 } align = left|top
                        autoresize = no multiline = yes alwaystransparent = yes
                    }
                    button_standard = {
                        name = "sltm_tab_capital_mark"
                        position = { 0 64 } size = { 202 30 }
                        text = "SLTM_TAB_CAPITAL_MARK"
                        enabled = "[GetScriptedGui('sltm_tab_capital_mark').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        onclick = "[GetScriptedGui('sltm_tab_capital_mark').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                    }
                    button_standard = {
                        name = "sltm_tab_capital_keep"
                        position = { 212 64 } size = { 124 30 }
                        text = "SLTM_TAB_KEEP"
                        enabled = "[GetScriptedGui('sltm_tab_capital_keep').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        onclick = "[GetScriptedGui('sltm_tab_capital_keep').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                    }
                    textbox = {
                        name = "capital_draft"
                        position = { 0 104 } size = { 648 43 }
                        text = "[GetPlayer.Custom('sltm_tab_capital_value')]" fontsize = 14 font = StandardGameFont
                        fontcolor = { 0.88 0.84 0.75 1 } align = left|top
                        autoresize = no multiline = yes alwaystransparent = yes
                    }
                    textbox = {
                        name = "dejure_title"
                        position = { 0 159 } size = { 165 26 }
                        text = "SLTM_TAB_DEJURE_TITLE" fontsize = 16 font = StandardGameFont
                        fontcolor = { 0.88 0.84 0.75 1 } align = left|top
                        autoresize = no multiline = yes alwaystransparent = yes
                    }
                    textbox = {
                        name = "dejure_current"
                        position = { 170 159 } size = { 480 27 }
                        text = "SLTM_TAB_DEJURE_CURRENT" fontsize = 14 font = StandardGameFont
                        fontcolor = { 0.68 0.65 0.59 1 } align = left|top
                        autoresize = no multiline = yes alwaystransparent = yes
                    }
                    textbox = {
                        name = "dejure_hint"
                        position = { 0 191 } size = { 650 28 }
                        text = "SLTM_TAB_DEJURE_NOTE" fontsize = 13 font = StandardGameFont
                        fontcolor = { 0.68 0.65 0.59 1 } align = left|top
                        autoresize = no multiline = yes alwaystransparent = yes
                    }
                    button_standard = {
                        name = "sltm_tab_dejure_mark"
                        position = { 0 223 } size = { 202 30 }
                        text = "SLTM_TAB_DEJURE_MARK"
                        enabled = "[GetScriptedGui('sltm_tab_dejure_mark').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        onclick = "[GetScriptedGui('sltm_tab_dejure_mark').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                    }
                    button_standard = {
                        name = "sltm_tab_dejure_keep"
                        position = { 212 223 } size = { 124 30 }
                        text = "SLTM_TAB_KEEP"
                        enabled = "[GetScriptedGui('sltm_tab_dejure_keep').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                        onclick = "[GetScriptedGui('sltm_tab_dejure_keep').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                    }
                    textbox = {
                        name = "dejure_draft"
                        position = { 0 263 } size = { 648 43 }
                        text = "[GetPlayer.Custom('sltm_tab_dejure_value')]" fontsize = 14 font = StandardGameFont
                        fontcolor = { 0.88 0.84 0.75 1 } align = left|top
                        autoresize = no multiline = yes alwaystransparent = yes
                    }
                }
            }
            scrollbar_vertical = { using = Scrollbar_Vertical }
        }
    }
}

