template sltm_choose_target_panel
{
    widget = { name = "choose_target_panel" size = { 1180 800 }
        visible = "[GetPlayer.MakeScope.Var('sltm_ui_choose_target').IsSet]"
        textbox = { name = "chooser_title" position = { 34 98 } size = { 1050 34 }
            text = "SLTM_CHOOSE_TITLE" fontsize = 22 font = StandardGameFont fontcolor = { 0.88 0.84 0.75 1 }
            align = left|top autoresize = no multiline = yes alwaystransparent = yes
        }
        textbox = { name = "chooser_desc" position = { 34 150 } size = { 1030 65 }
            text = "SLTM_CHOOSE_DESC" fontsize = 16 font = StandardGameFont fontcolor = { 0.88 0.84 0.75 1 }
            align = left|top autoresize = no multiline = yes alwaystransparent = yes
        }
        textbox = { name = "chooser_mark" position = { 34 225 } size = { 1050 40 }
            text = "[GetPlayer.Custom('sltm_native_current_mark')]" fontsize = 14 font = StandardGameFont fontcolor = { 0.88 0.84 0.75 1 }
            align = left|top autoresize = no multiline = yes alwaystransparent = yes
        }
        button_standard = { name = "choose_last" position = { 34 300 } size = { 210 34 }
            text = "SLTM_CHOOSE_LAST" enabled = "[GetScriptedGui('sltm_ui_choose_last').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            onclick = "[GetScriptedGui('sltm_ui_choose_last').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        }
        button_standard = { name = "choose_close" position = { 34 730 } size = { 105 34 }
            text = "SLTM_CHOOSE_CLOSE" enabled = "[GetScriptedGui('sltm_ui_choose_close').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            onclick = "[GetScriptedGui('sltm_ui_choose_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        }
    }
}
