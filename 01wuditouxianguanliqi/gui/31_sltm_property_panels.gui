template sltm_native_title_marker_row
{
    hbox = {
        name = "sltm_native_title_mark_row"
        layoutpolicy_horizontal = expanding
        ignoreinvisible = yes
        margin = { 20 10 }
        background = { using = Background_Area_Dark alpha = 0.6 }
        text_single = { text = "SLTM_NATIVE_MARK_CAPTION" }
        widget = {
            name = "sltm_native_mark_coa"
            size = { 40 20 }
            datacontext = "[GetPlayer.MakeScope.Var('sltm_designee_title').Title]"
            visible = "[GetScriptedGui('sltm_lvm_clear_designee_title_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            coa_title_tiny_crown = { position = { 0 -10 } }
        }
        text_single = {
            name = "sltm_native_mark_status"
            layoutpolicy_horizontal = expanding
            text = "[GetPlayer.Custom('sltm_native_current_mark')]"
            elide = right
        }
        button_round = {
            name = "sltm_native_mark_viewed"
            tooltip = "SLTM_NATIVE_MARK_HINT"
            onclick = "[GetScriptedGui('sltm_native_mark_viewed_title').Execute(GuiScope.SetRoot(TitleViewWindow.GetTitle.MakeScope).AddScope('sltm_viewer',GetPlayer.MakeScope).End)]"
            enabled = "[GetScriptedGui('sltm_native_mark_viewed_title').IsValid(GuiScope.SetRoot(TitleViewWindow.GetTitle.MakeScope).AddScope('sltm_viewer',GetPlayer.MakeScope).End)]"
            onrightclick = "[GetScriptedGui('sltm_lvm_clear_designee_title_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            button_ignore = none
            button_pin = { parentanchor = center alwaystransparent = yes }
        }
    }
}

template sltm_appearance_panel
{
    widget = { name = "appearance_panel" position = { 182 190 } size = { 690 525 }
        visible = "[GetScriptedGui('sltm_tab_appearance_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        textbox = { name = "appearance_heading" position = { 0 0 } size = { 374 24 }
            text = "SLTM_LOOK_TITLE" fontsize = 17 font = StandardGameFont fontcolor = { 0.88 0.84 0.75 1 }
            align = left|top autoresize = no multiline = yes alwaystransparent = yes
        }
        button_primary = {
            name = "open_native_title_appearance" position = { 388 0 } size = { 282 34 }
            text = "SLTM_LOOK_OPEN_NATIVE_EDITOR"
