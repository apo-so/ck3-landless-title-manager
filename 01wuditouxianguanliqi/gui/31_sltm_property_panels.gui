template sltm_draft_summary_panel
{
    textbox = { name = "summary_target" position = { 886 216 } size = { 270 40 }
        text = "SLTM_SUM_A" fontsize = 14 font = StandardGameFont fontcolor = { 0.88 0.84 0.75 1 }
        align = left|top autoresize = no multiline = yes alwaystransparent = yes
    }
    textbox = { name = "summary_current_b" position = { 886 258 } size = { 270 40 }
        text = "[GetPlayer.Custom('sltm_native_current_mark')]" fontsize = 14 font = StandardGameFont fontcolor = { 0.67 0.65 0.59 1 }
        align = left|top autoresize = no multiline = yes alwaystransparent = yes
    }
    scrollbox = { name = "summary_live" position = { 882 303 } size = { 276 410 }
        visible = "[GetScriptedGui('sltm_ui_has_changes').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        blockoverride "scrollbox_background" {}
        blockoverride "scrollbox_background_fade" {}
        blockoverride "scrollbox_margins" { margin = { 4 3 } ignoreinvisible = yes }
        blockoverride "scrollbox_content" {
            text_multi = { name = "draft_name"
                visible = "[GetPlayer.MakeScope.Var('sltm_edit_name').IsSet]"
                text = "SLTM_SUM_NAME" autoresize = yes max_width = 245 fontsize = 14 margin_bottom = 6
                align = left|top alwaystransparent = yes
            }
            text_multi = { name = "draft_prefix"
                visible = "[GetPlayer.MakeScope.Var('sltm_edit_prefix').IsSet]"
                text = "SLTM_SUM_PREFIX" autoresize = yes max_width = 245 fontsize = 14 margin_bottom = 6
                align = left|top alwaystransparent = yes
            }
            text_multi = { name = "draft_coa"
                visible = "[GetPlayer.MakeScope.Var('sltm_edit_coa').IsSet]"
                text = "SLTM_SUM_COA" autoresize = yes max_width = 245 fontsize = 14 margin_bottom = 6
                align = left|top alwaystransparent = yes
            }
            text_multi = { name = "draft_color"
                visible = "[GetPlayer.MakeScope.Var('sltm_edit_color').IsSet]"
                text = "SLTM_SUM_COLOR" autoresize = yes max_width = 245 fontsize = 14 margin_bottom = 6
                align = left|top alwaystransparent = yes
            }
            text_multi = { name = "draft_definitive"
                visible = "[GetPlayer.MakeScope.Var('sltm_edit_definitive').IsSet]"
                text = "SLTM_SUM_DEFINITIVE" autoresize = yes max_width = 245 fontsize = 14 margin_bottom = 6
                align = left|top alwaystransparent = yes
            }
            text_multi = { name = "draft_dynasty"
                visible = "[GetPlayer.MakeScope.Var('sltm_edit_dynasty').IsSet]"
                text = "SLTM_SUM_DYNASTY" autoresize = yes max_width = 245 fontsize = 14 margin_bottom = 6
                align = left|top alwaystransparent = yes
            }
            text_multi = { name = "draft_nomadic"
                visible = "[GetPlayer.MakeScope.Var('sltm_edit_nomadic').IsSet]"
                text = "SLTM_SUM_NOMADIC" autoresize = yes max_width = 245 fontsize = 14 margin_bottom = 6
                align = left|top alwaystransparent = yes
            }
            text_multi = { name = "draft_capital"
                visible = "[GetPlayer.MakeScope.Var('sltm_edit_capital').IsSet]"
                text = "SLTM_SUM_CAPITAL" autoresize = yes max_width = 245 fontsize = 14 margin_bottom = 6
                align = left|top alwaystransparent = yes
            }
            text_multi = { name = "draft_dejure"
                visible = "[GetPlayer.MakeScope.Var('sltm_edit_dejure').IsSet]"
                text = "SLTM_SUM_DEJURE" autoresize = yes max_width = 245 fontsize = 14 margin_bottom = 6
                align = left|top alwaystransparent = yes
            }
            text_multi = { name = "draft_heir"
                visible = "[GetPlayer.MakeScope.Var('sltm_edit_heir').IsSet]"
                text = "SLTM_SUM_HEIR" autoresize = yes max_width = 245 fontsize = 14 margin_bottom = 6
                align = left|top alwaystransparent = yes
            }
            text_multi = { name = "draft_claims"
                visible = "[GetPlayer.MakeScope.Var('sltm_edit_claims').IsSet]"
                text = "SLTM_SUM_CLAIMS" autoresize = yes max_width = 245 fontsize = 14 margin_bottom = 6
                align = left|top alwaystransparent = yes
            }
            text_multi = { name = "draft_landless"
