############################################################
# 持有者互动面板
# 前置条件：当前 datacontext 必须为 Character。
# 布局规则：每行两个 165×30 固定槽位，槽位本身始终存在；
# 仅隐藏槽位内按钮，避免单按钮出现时被 hbox 重新排版而左右漂移。
############################################################
template sltm_lvm_holder_interaction_panel
{
    vbox = {
        layoutpolicy_horizontal = expanding
        spacing = 4

        divider = { layoutpolicy_horizontal = expanding }
        text_single = {
            size = { 100% 28 }
            text = SLTM_LVM_SECTION_HOLDER_ACTIONS
            using = Font_Size_Medium
            align = left|nobaseline
            autoresize = no
        }

        # 常用管理：契约与封臣指令
        hbox = {
            size = { 336 30 }
            spacing = 6
            visible = "[Or(Character.IsPlayerInteractionShown('admin_liege_modify_vassal_contract_interaction'), Character.IsPlayerInteractionShown('give_vassal_directive_interaction'))]"
            widget = {
                size = { 165 30 }
                button_standard = {
                    size = { 165 30 }
                    visible = "[Character.IsPlayerInteractionShown('admin_liege_modify_vassal_contract_interaction')]"
                    enabled = "[Character.IsPlayerInteractionValid('admin_liege_modify_vassal_contract_interaction')]"
                    text = SLTM_LVM_HOLDER_ACT_CONTRACT
                    onclick = "[Character.OpenPlayerInteraction('admin_liege_modify_vassal_contract_interaction')]"
                    tooltip = "[Character.GetPlayerInteractionTooltip('admin_liege_modify_vassal_contract_interaction')]"
                    using = tooltip_se
                }
            }
            widget = {
                size = { 165 30 }
                button_standard = {
                    size = { 165 30 }
                    visible = "[Character.IsPlayerInteractionShown('give_vassal_directive_interaction')]"
                    enabled = "[Character.IsPlayerInteractionValid('give_vassal_directive_interaction')]"
                    text = SLTM_LVM_HOLDER_ACT_DIRECTIVE
                    onclick = "[Character.OpenPlayerInteraction('give_vassal_directive_interaction')]"
                    tooltip = "[Character.GetPlayerInteractionTooltip('give_vassal_directive_interaction')]"
                    using = tooltip_se
                }
            }
        }

        # 驻地管理：选择新驻地 / 直接搬迁庄园至现有首府
        hbox = {
            size = { 336 30 }
            spacing = 6
            visible = "[Or('(bool)no', '(bool)no')]"
            widget = {
                size = { 165 30 }
                
            }
            widget = {
                size = { 165 30 }
                
            }
        }

        # 军政命令
        hbox = {
            size = { 336 30 }
            spacing = 6
            visible = "[Or('(bool)no', '(bool)no')]"
            widget = {
                size = { 165 30 }
                
            }
            widget = {
                size = { 165 30 }
                
            }
        }

        # 征服与国库拨款
        hbox = {
            size = { 336 30 }
            spacing = 6
            visible = "[Or('(bool)no', '(bool)no')]"
            widget = {
                size = { 165 30 }
                
            }
            widget = {
                size = { 165 30 }
                
            }
        }

        # 债务与罢免
        hbox = {
            size = { 336 30 }
            spacing = 6
            visible = "[Or('(bool)no', Character.IsPlayerInteractionShown('governor_removal_interaction'))]"
            widget = {
                size = { 165 30 }
                
            }
            widget = {
                size = { 165 30 }
                button_standard = {
                    size = { 165 30 }
                    visible = "[Character.IsPlayerInteractionShown('governor_removal_interaction')]"
                    enabled = "[Character.IsPlayerInteractionValid('governor_removal_interaction')]"
                    text = SLTM_LVM_HOLDER_ACT_REMOVE_GOVERNOR
                    onclick = "[Character.OpenPlayerInteraction('governor_removal_interaction')]"
                    tooltip = "[Character.GetPlayerInteractionTooltip('governor_removal_interaction')]"
                    using = tooltip_se
                }
            }
        }

        # 高风险与部长专属敕令
        hbox = {
            size = { 336 30 }
            spacing = 6
            visible = "[Or('(bool)no', '(bool)no')]"
            widget = {
                size = { 165 30 }
                
            }
            widget = {
                size = { 165 30 }
                
            }
        }

        hbox = {
            size = { 336 30 }
            spacing = 6
            visible = no
            widget = {
                size = { 165 30 }
                
            }
            widget = { size = { 165 30 } }
        }

        # 保留进入原版完整人物互动菜单的出口，不重复实现婚姻、阴谋等通用互动。
        button_standard = {
            size = { 336 32 }
            text = SLTM_LVM_HOLDER_ACT_MORE
            onclick = "[DefaultOnCharacterRightClick(Character.GetID)]"
            tooltip = SLTM_LVM_HOLDER_ACT_MORE_TT
            using = tooltip_se
        }
    }
}

template sltm_lvm_title_row
{
    widget = {
        size = { @sltm_lvm_page_left_content_width @sltm_lvm_title_row_height }
        datacontext = "[Scope.Title]"

        # CLICKFIX-R3：底层整行按钮只负责选中本 Mod 行。
        # 仅可见纹章/头衔名称设置原版跳转热区；其他空白与数据区域不得跳转。
        button_standard_list = {
            size = { @sltm_lvm_page_left_content_width @sltm_lvm_title_row_height }
            onclick = "[GetScriptedGui('sltm_lvm_select_title_gui').Execute(GuiScope.SetRoot(Scope.Title.MakeScope).AddScope('player', GetPlayer.MakeScope).End)]"
            button_ignore = none
            down = "[And(GetPlayer.MakeScope.Var('sltm_lvm_selected_title').IsSet, ObjectsEqual(Title.Self, GetPlayer.MakeScope.Var('sltm_lvm_selected_title').Title))]"
        }

        # 与表头完全相同的五列横排结构：头衔身份、持有者、类型、兵团、状态。
        hbox = {
            layoutpolicy_horizontal = fixed
            size = { @sltm_lvm_page_left_content_width @sltm_lvm_title_row_height }
            spacing = 6

            # 原版式头衔身份组件：只有纹章本体与头衔名称文字范围进入原版头衔页。
            widget = {
                layoutpolicy_horizontal = fixed
                size = { @sltm_lvm_title_identity_width @sltm_lvm_title_row_height }
                hbox = {
                    size = { 100% @sltm_lvm_title_row_height }
                    spacing = 6

                    widget = {
                        size = { @sltm_lvm_col_coa @sltm_lvm_title_row_height }
                        # R8.7：coa_title_tiny_crown 本体已继承 CoA_Title_Defaults，
                        # 自带原版头衔点击/右键/tooltip；不再叠加 50x54 透明按钮扩大热区。
                        coa_title_tiny_crown = { parentanchor = center }
                    }

                    vbox = {
                        size = { @sltm_lvm_col_title @sltm_lvm_title_row_height }
                        margin_top = 7
                        spacing = 1
                        widget = {
                            # R8.7：视觉文字仍保留 202px，导航热区缩到左侧 128x22；
                            # 其余列内空白继续落到底层整行选择按钮。
                            size = { 202 24 }
                            text_single = { size = { 202 24 } text = "[Title.GetNameNoTierNoTooltip]" using = Font_Size_Small default_format = "#clickable" align = left|nobaseline autoresize = no alwaystransparent = yes max_width = 202 }
                            button = {
                                position = { 0 1 }
                                size = { 128 22 }
                                # 单一意图：只跳原版头衔页，不同时改本 Mod 选中状态。
                                onclick = "[DefaultOnCoatOfArmsClick(Title.GetID)]"
                                onrightclick = "[DefaultOnCoatOfArmsRightClick(Title.GetID)]"
                                button_ignore = none
                                tooltipwidget = { using = LandedTitleTooltip }
                            }
                        }
                        text_single = { size = { 248 22 } text = TV_TIER_INFO using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no alwaystransparent = yes max_width = 248 }
                    }
                }
            }

            # 持有者列是一个固定单元；有持有者按钮和无持有者文本在单元内重叠，
            # 不得作为外层 hbox 的两个独立子项。
            widget = {
                size = { @sltm_lvm_col_holder @sltm_lvm_title_row_height }
                vbox = {
                    size = { 100% @sltm_lvm_title_row_height }
                    visible = "[Title.HasHolder]"
                    datacontext = "[Title.GetHolder]"
                    margin_left = 6
                    margin_top = 8
                    spacing = 2
                    text_single = {
                        size = { 218 25 }
                        text = "[Character.GetNameNoTooltip]"
                        using = Font_Size_Small
                        default_format = "#high"
                        align = left|nobaseline
                        autoresize = no
                        alwaystransparent = yes
                    }
                    text_single = {
                        size = { 218 23 }
                        raw_text = "[Character.GetAge] · [Character.GetRelationToString( GetPlayer )]"
                        using = Font_Size_Small
                        default_format = "#low"
                        align = left|nobaseline
                        autoresize = no
                        alwaystransparent = yes
                    }
                }
                text_single = {
                    size = { 100% @sltm_lvm_title_row_height }
                    visible = "[Not(Title.HasHolder)]"
                    text = SLTM_LVM_NO_VALID_HOLDER
                    using = Font_Size_Small
                    align = left|nobaseline
                    autoresize = no
                    alwaystransparent = yes
                    margin_left = 6
                }
            }

            # 无地头衔通常没有法理上级；主列表优先展示可用于筛选与排序的类型。
            widget = {
                size = { @sltm_lvm_col_type @sltm_lvm_title_row_height }
                text_single = { position = { 6 9 } size = { 138 22 } visible = "[ObjectsEqual(Title.MakeScope.Var('sltm_lvm_display_type').GetFlagName, 'junfu')]" text = SLTM_LVM_FILTER_TYPE_JUNFU using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no alwaystransparent = yes }
                text_single = { position = { 6 9 } size = { 138 22 } visible = "[ObjectsEqual(Title.MakeScope.Var('sltm_lvm_display_type').GetFlagName, 'chaochen')]" text = SLTM_LVM_FILTER_TYPE_CHAOCHEN using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no alwaystransparent = yes }
                text_single = { position = { 6 9 } size = { 138 22 } visible = "[ObjectsEqual(Title.MakeScope.Var('sltm_lvm_display_type').GetFlagName, 'noble_family')]" text = SLTM_LVM_FILTER_TYPE_NOBLE using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no alwaystransparent = yes }
                text_single = { position = { 6 9 } size = { 138 22 } visible = "[ObjectsEqual(Title.MakeScope.Var('sltm_lvm_display_type').GetFlagName, 'holy_order')]" text = SLTM_LVM_FILTER_TYPE_HOLY_ORDER using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no alwaystransparent = yes }
                text_single = { position = { 6 9 } size = { 138 22 } visible = "[ObjectsEqual(Title.MakeScope.Var('sltm_lvm_display_type').GetFlagName, 'mercenary')]" text = SLTM_LVM_FILTER_TYPE_MERCENARY using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no alwaystransparent = yes }
                text_single = { position = { 6 9 } size = { 138 22 } visible = "[ObjectsEqual(Title.MakeScope.Var('sltm_lvm_display_type').GetFlagName, 'religious_head')]" text = SLTM_LVM_FILTER_TYPE_RELIGIOUS_HEAD using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no alwaystransparent = yes }
                text_single = { position = { 6 9 } size = { 138 22 } visible = "[ObjectsEqual(Title.MakeScope.Var('sltm_lvm_display_type').GetFlagName, 'other')]" text = SLTM_LVM_FILTER_TYPE_OTHER using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no alwaystransparent = yes }
            }

            # 2026-07-18（V3.4-B）兵团数（类型与状态之间；缓存 sltm_lvm_title_maa_count，打开/刷新时重算）
            widget = {
                size = { @sltm_lvm_col_maa @sltm_lvm_title_row_height }
                text_single = {
                    position = { 0 9 }
                    size = { 100% 22 }
                    visible = "[GreaterThan_CFixedPoint(Title.MakeScope.Var('sltm_lvm_title_maa_count').GetValue, '(CFixedPoint)0')]"
                    text = "[Title.MakeScope.Var('sltm_lvm_title_maa_count').GetValue|0]"
                    using = Font_Size_Small
                    default_format = "#high"
                    align = center|nobaseline
                    autoresize = no
                    alwaystransparent = no
                    tooltip = SLTM_LVM_COLUMN_MAA_TT
                }
                text_single = {
                    position = { 0 9 }
                    size = { 100% 22 }
                    visible = "[Not(GreaterThan_CFixedPoint(Title.MakeScope.Var('sltm_lvm_title_maa_count').GetValue, '(CFixedPoint)0'))]"
                    raw_text = "—"
                    using = Font_Size_Small
                    default_format = "#low"
                    align = center|nobaseline
                    autoresize = no
                    alwaystransparent = yes
                }
            }

            widget = {
                size = { @sltm_lvm_col_status @sltm_lvm_title_row_height }
                text_single = {
                    position = { 6 8 }
                    size = { 172 22 }
                    visible = "[Not(Title.HasHolder)]"
                    text = SLTM_LVM_FILTER_CREATION_UNCREATED
                    using = Font_Size_Small
                    default_format = "#N"
                    align = left|nobaseline
                    autoresize = no
                    alwaystransparent = no
                    tooltip = SLTM_LVM_FILTER_CREATION_UNCREATED_TT
                }
                text_single = {
                    position = { 6 8 }
                    size = { 172 22 }
                    visible = "[Title.MakeScope.Var('mytm_junfu_handover_blocked').IsSet]"
                    text = SLTM_LVM_STATUS_BLOCKED
                    using = Font_Size_Small
                    default_format = "#N"
                    align = left|nobaseline
                    autoresize = no
                    alwaystransparent = no
                    tooltip = SLTM_LVM_STATUS_BLOCKED_TT
                }
                text_single = {
                    position = { 6 8 }
                    size = { 172 22 }
                    visible = "[And(Not(Title.MakeScope.Var('mytm_junfu_handover_blocked').IsSet), Title.MakeScope.Var('mytm_reassign_pending').IsSet)]"
                    text = SLTM_LVM_STATUS_PENDING
                    using = Font_Size_Small
                    default_format = "#P"
                    align = left|nobaseline
                    autoresize = no
                    alwaystransparent = no
                    tooltip = SLTM_LVM_STATUS_PENDING_TT
                }
                text_single = {
                    position = { 6 8 }
                    size = { 172 22 }
                    visible = "[And(And(Not(Title.MakeScope.Var('mytm_junfu_handover_blocked').IsSet), Not(Title.MakeScope.Var('mytm_reassign_pending').IsSet)), And(Title.HasHolder, ObjectsEqual(Title.GetHolder.GetPrimaryTitle, Title.Self)))]"
                    text = SLTM_LVM_FILTER_STATUS_PRIMARY
                    using = Font_Size_Small
                    align = left|nobaseline
                    autoresize = no
                    alwaystransparent = no
                    tooltip = SLTM_LVM_STATUS_PRIMARY_TT
                }
                text_single = {
                    position = { 6 8 }
                    size = { 172 22 }
                    visible = "[And(And(Not(Title.MakeScope.Var('mytm_junfu_handover_blocked').IsSet), Not(Title.MakeScope.Var('mytm_reassign_pending').IsSet)), And(Title.HasHolder, Not(ObjectsEqual(Title.GetHolder.GetPrimaryTitle, Title.Self))))]"
                    text = SLTM_LVM_FILTER_STATUS_CONCURRENT
                    using = Font_Size_Small
                    align = left|nobaseline
                    autoresize = no
                    alwaystransparent = no
                    tooltip = SLTM_LVM_STATUS_CONCURRENT_TT
                }
            }
            expand = {}
        }
    }
}

template sltm_lvm_holder_row
{
    widget = {
        size = { @sltm_lvm_page_left_content_width @sltm_lvm_holder_row_height }
        datacontext = "[Scope.GetCharacter]"
        button_standard_list = {
            size = { @sltm_lvm_page_left_content_width @sltm_lvm_holder_row_height }
            onclick = "[GetScriptedGui('sltm_lvm_select_character_gui').Execute(GuiScope.SetRoot(Character.MakeScope).AddScope('player', GetPlayer.MakeScope).End)]"
            button_ignore = none
            down = "[And(GetPlayer.MakeScope.Var('sltm_lvm_selected_character').IsSet, ObjectsEqual(Character.Self, GetPlayer.MakeScope.Var('sltm_lvm_selected_character').Char))]"
        }

        # 2026-07-18（V3.4-A）行 hbox 与表头共用 layoutpolicy_horizontal=fixed + 同宽（照头衔页），保证列纵横对齐、不被挤成"…"。
        hbox = {
            layoutpolicy_horizontal = fixed
            size = { @sltm_lvm_page_left_content_width @sltm_lvm_holder_row_height }
            spacing = @sltm_lvm_holder_col_gap

            # 头像
            widget = {
                size = { @sltm_lvm_holder_col_portrait @sltm_lvm_holder_row_height }
                portrait_head_small = {
                    parentanchor = center
                    scale = 0.82
                    # R8.7：portrait_head_small -> portrait_base 本体自带 80x100 人物点击。
                    # 这里显式关闭内建点击/右键/tooltip，并让内建 portrait_button 对鼠标透明，
                    # 避免与下面的小热区形成“点击并集”。
                    blockoverride "portrait_button_template_onclick" {}
                    blockoverride "portrait_button_template_onrightclick" {}
                    blockoverride "portrait_button_template_tooltip" {}
                    blockoverride "portrait_button" { alwaystransparent = yes }
                }
                button = {
                    parentanchor = center
                    size = { 42 46 }
                    # R8.7 单一意图：仅头像中央可见区域跳人物页；周边头像框/空白仍选中行。
                    onclick = "[DefaultOnCharacterClick(Character.GetID)]"
                    onrightclick = "[DefaultOnCharacterRightClick(Character.GetID)]"
                    button_ignore = none
                    tooltipwidget = { container_character_tooltip = {} }
                }
            }

            # 人物姓名仅展示；原版人物跳转只允许点击头像本体。
            widget = {
                size = { @sltm_lvm_holder_col_character @sltm_lvm_holder_row_height }
                vbox = {
                    size = { 100% @sltm_lvm_holder_row_height }
                    margin_top = 16
                    spacing = 2
                    text_single = { size = { 218 24 } text = "[Character.GetNameNoTooltip]" using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no alwaystransparent = yes margin_left = 6 elide = right }
                    text_single = { size = { 218 20 } raw_text = "[Character.GetAge] · [Character.GetRelationToString( GetPlayer )]" using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no alwaystransparent = yes margin_left = 6 elide = right }
                }
            }

            # 头衔类型列已删（V3.4-A2）

            # 主头衔：最多两行，不自动扩展；使用固定单元格，避免 vbox 基线改变列宽。
            widget = {
                size = { @sltm_lvm_holder_col_primary @sltm_lvm_holder_row_height }
                # R8.7：显示框保持188x42，但导航热区只保留中央 132x24，避免整块主头衔单元可点击。
                text_multi = { parentanchor = center size = { 188 42 } text = "[Character.GetPrimaryTitle.GetNameWithUnderlyingNoTooltip]" using = Font_Size_Small default_format = "#clickable" align = left autoresize = no max_width = 188 alwaystransparent = yes }
                button = {
                    parentanchor = center
                    size = { 132 24 }
                    datacontext = "[Character.GetPrimaryTitle]"
                    # R8.6 单一意图：主头衔热区只跳头衔页。
                    onclick = "[DefaultOnCoatOfArmsClick(Title.GetID)]"
                    onrightclick = "[DefaultOnCoatOfArmsRightClick(Title.GetID)]"
                    button_ignore = none
                    tooltipwidget = { using = LandedTitleTooltip }
                }
            }

            # 五维（外交/军事/管理/谋略/学识）列已删（V3.4-A2）

            # V3.4-A：管理总数/待处理/受阻三列已删（改前备份 V34_batchA_holderlist_backup_20260718_063343）。改为：贤能/总督效率/月国库/兵力/参战。
            # 贤能品级：固定单元格；align 只放在 text_single 上，不能放在 vbox/widget 上。
            widget = {
                size = { @sltm_lvm_holder_col_merit @sltm_lvm_holder_row_height }
                text_single = { parentanchor = center size = { 100% 22 } visible = "[GreaterThan_int32(Character.GetMeritLevel, '(int32)0')]" text = "[GetMeritLevelShortNameNoTooltip(Character.GetMeritLevel)]" using = Font_Size_Small default_format = "#high" align = center|nobaseline autoresize = no tooltip = "[Character.GetMeritTooltipWithBalance]" }
                text_single = { parentanchor = center size = { 100% 22 } visible = "[Not(GreaterThan_int32(Character.GetMeritLevel, '(int32)0'))]" raw_text = "—" using = Font_Size_Small default_format = "#low" align = center|nobaseline autoresize = no }
            }
            # 总督效率
            widget = {
                size = { @sltm_lvm_holder_col_efficiency @sltm_lvm_holder_row_height }
                text_single = { parentanchor = center size = { 100% 22 } visible = "[Or( Character.GetGovernment.HasRule( 'administrative' ), And( And( Not( Character.HasLandedTitles ), Not( Character.HasLiege ) ), GetPlayer.GetGovernment.HasRule( 'administrative' ) ) )]" text = "ADMIN_WINDOW_THEME_GOVERNOR_EFFICIENCY_VALUE" using = Font_Size_Small align = center|nobaseline autoresize = no tooltip = "ADMIN_WINDOW_THEME_GOVERNOR_EFFICIENCY_TT" }
                text_single = { parentanchor = center size = { 100% 22 } visible = "[Not(Or( Character.GetGovernment.HasRule( 'administrative' ), And( And( Not( Character.HasLandedTitles ), Not( Character.HasLiege ) ), GetPlayer.GetGovernment.HasRule( 'administrative' ) ) ))]" raw_text = "—" using = Font_Size_Small default_format = "#low" align = center|nobaseline autoresize = no }
            }
            # 月国库收支
            widget = {
                size = { @sltm_lvm_holder_col_treasury @sltm_lvm_holder_row_height }
                text_single = { parentanchor = center size = { 100% 22 } text = "[Character.GetTreasuryBalance|=+1]" using = Font_Size_Small align = center|nobaseline autoresize = no tooltip = "[Character.GetTreasuryTooltipWithBalance]" }
            }
            # 国库总额：仅有国库系统的人物显示数值，其余显示破折号。
            widget = {
                size = { @sltm_lvm_holder_col_treasury_total @sltm_lvm_holder_row_height }
                text_single = { parentanchor = center size = { 100% 22 } visible = "[Character.HasTreasury]" text = "[Character.GetTreasury|0]" using = Font_Size_Small default_format = "#high" align = center|nobaseline autoresize = no tooltip = "[Character.GetTreasuryTooltipWithBalance]" }
                text_single = { parentanchor = center size = { 100% 22 } visible = "[Not(Character.HasTreasury)]" raw_text = "—" using = Font_Size_Small default_format = "#low" align = center|nobaseline autoresize = no }
            }
            # 总兵力
            widget = {
                size = { @sltm_lvm_holder_col_strength @sltm_lvm_holder_row_height }
                text_single = { parentanchor = center size = { 100% 22 } text = "[Character.GetMilitaryStrengthText]" using = Font_Size_Small default_format = "#high" align = center|nobaseline autoresize = no tooltip = SLTM_LVM_COLUMN_STRENGTH_TT }
            }
            # V3.7.0：参战角色细分；固定单元格宽度不变，表头与其他列不会移动。
            widget = {
                size = { @sltm_lvm_holder_col_atwar @sltm_lvm_holder_row_height }
                text_single = {
                    parentanchor = center
                    size = { 100% 22 }
                    text = "[Character.Custom('sltm_lvm_war_role_text')]"
                    using = Font_Size_Small
                    align = center|nobaseline
                    autoresize = no
                    tooltip = SLTM_LVM_COLUMN_ATWAR_ROLE_TT
                    using = tooltip_ne
                }
            }
            # 九列宽度与八个间隔合计998，不再追加尾部占位列。
        }
    }
}


############################################################
# R10-35A 国库管理页行营财政行
############################################################
template sltm_lvm_treasury_row
{
    widget = {
        size = { @sltm_lvm_page_left_content_width @sltm_lvm_treasury_row_height }
        datacontext = "[Scope.GetCharacter]"
        button_standard_list = {
            size = { @sltm_lvm_page_left_content_width @sltm_lvm_treasury_row_height }
            onclick = "[GetScriptedGui('sltm_lvm_select_treasury_character_gui').Execute(GuiScope.SetRoot(Character.MakeScope).AddScope('player', GetPlayer.MakeScope).End)]"
            button_ignore = none
            down = "[And(GetPlayer.MakeScope.Var('sltm_lvm_treasury_selected_character').IsSet, ObjectsEqual(Character.Self, GetPlayer.MakeScope.Var('sltm_lvm_treasury_selected_character').Char))]"
        }
        hbox = {
            layoutpolicy_horizontal = fixed size = { @sltm_lvm_page_left_content_width @sltm_lvm_treasury_row_height } spacing = @sltm_lvm_treasury_col_gap
            widget = {
                size = { @sltm_lvm_treasury_col_identity @sltm_lvm_treasury_row_height }
                hbox = {
                    size = { 100% @sltm_lvm_treasury_row_height } spacing = 6
                    widget = {
                        size = { @sltm_lvm_col_coa @sltm_lvm_treasury_row_height }
                        portrait_head_small = {
                            parentanchor = center
                            scale = 0.82
                            # R8.7：关闭 portrait_head_small 内建的大人物点击区，只保留下方显式小热区。
                            blockoverride "portrait_button_template_onclick" {}
                            blockoverride "portrait_button_template_onrightclick" {}
                            blockoverride "portrait_button_template_tooltip" {}
                            blockoverride "portrait_button" { alwaystransparent = yes }
                        }
                        button = {
                            parentanchor = center
                            size = { 42 46 }
                            # R8.7 单一意图：仅头像中央可见区域跳人物页；周边仍选中财政行。
                            onclick = "[DefaultOnCharacterClick(Character.GetID)]"
                            onrightclick = "[DefaultOnCharacterRightClick(Character.GetID)]"
                            button_ignore = none
                            tooltipwidget = { container_character_tooltip = {} }
                        }
                    }
                    vbox = {
                        layoutpolicy_horizontal = expanding margin_top = 7
                        text_single = { size = { 154 24 } text = "[Character.GetNameNoTooltip]" using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no alwaystransparent = yes elide = right }
                        text_single = { size = { 154 21 } raw_text = "[Character.GetAge] · [Character.GetRelationToString( GetPlayer )]" using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no alwaystransparent = yes elide = right }
                    }
                }
            }
            widget = {
                size = { @sltm_lvm_treasury_col_holder @sltm_lvm_treasury_row_height }
                vbox = {
                    size = { 100% @sltm_lvm_treasury_row_height } margin_left = 5 margin_top = 7
                    text_single = { size = { 134 24 } text = "[Character.GetPrimaryTitle.GetNameWithUnderlyingNoTooltip]" using = Font_Size_Small default_format = "#clickable" align = left|nobaseline autoresize = no alwaystransparent = yes elide = right }
                    text_single = { visible = "[GetScriptedGui('sltm_lvm_treasury_is_junfu_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 134 21 } text = SLTM_LVM_TREASURY_TYPE_JUNFU using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no }
                    text_single = { visible = "[And(Not(GetScriptedGui('sltm_lvm_treasury_is_junfu_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)), GetScriptedGui('sltm_lvm_treasury_is_military_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]" size = { 134 21 } text = SLTM_LVM_TREASURY_TYPE_MILITARY using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no }
                    text_single = { visible = "[And(Not(GetScriptedGui('sltm_lvm_treasury_is_junfu_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)), Not(GetScriptedGui('sltm_lvm_treasury_is_military_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)))]" size = { 134 21 } text = SLTM_LVM_TREASURY_TYPE_OTHER using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                }
                button = {
                    position = { 5 8 }
                    size = { 104 22 }
                    datacontext = "[Character.GetPrimaryTitle]"
                    # R8.7 单一意图：只保留主头衔文字左侧紧凑热区；其余单元空白选中财政行。
                    onclick = "[DefaultOnCoatOfArmsClick(Title.GetID)]"
                    onrightclick = "[DefaultOnCoatOfArmsRightClick(Title.GetID)]"
                    button_ignore = none
                    tooltipwidget = { using = LandedTitleTooltip }
                }
            }
            vbox = {
                size = { @sltm_lvm_treasury_col_private @sltm_lvm_treasury_row_height } margin_top = 0 spacing = 1
                # R8.10：仅将私库财政三行数据块相对本行整体上移 5px；三行节奏与横向布局不变。
                # R8.9：三行紧凑财政。第一行合并“存 / 入 / 净”，第二、三行保留四档军费。
                hbox = {
                    size = { 100% 20 }
                    hbox = { size = { 60 20 } text_single = { size = { 16 20 } text = SLTM_LVM_TREASURY_SHORT_STOCK using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no tooltip = "[Character.GetGoldTooltipWithBalance]" } text_single = { size = { 44 20 } text = "[Character.GetGold|0]" using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no tooltip = "[Character.GetGoldTooltipWithBalance]" } }
                    hbox = { size = { 60 20 } text_single = { size = { 16 20 } text = SLTM_LVM_TREASURY_SHORT_IN using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_PRIVATE_INCOME_TT } text_single = { size = { 44 20 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_private_income_value')|1]" using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_PRIVATE_INCOME_TT } }
                    hbox = { size = { 60 20 } text_single = { size = { 16 20 } text = SLTM_LVM_TREASURY_SHORT_NET using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no tooltip = "[Character.GetGoldTooltipWithBalance]" } text_single = { size = { 44 20 } text = "[Character.GetBalance|=+1]" using = Font_Size_Small align = left|nobaseline autoresize = no tooltip = "[Character.GetGoldTooltipWithBalance]" } }
                }
                hbox = { size = { 100% 20 } text_single = { size = { 20 20 } text = SLTM_LVM_TREASURY_SHORT_MIN using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_MIN_GOLD_TT } text_single = { size = { 65 20 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_gold_ai_maa_min_budget_value')|1]" using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_MIN_GOLD_TT } text_single = { size = { 20 20 } text = SLTM_LVM_TREASURY_SHORT_NORMAL using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_NORMAL_GOLD_TT } text_single = { size = { 70 20 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_actual_gold_maa_expense_value')|2]" using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_NORMAL_GOLD_TT } }
                hbox = { size = { 100% 20 } text_single = { size = { 20 20 } text = SLTM_LVM_TREASURY_SHORT_TARGET using = Font_Size_Small default_format = "#P" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_TARGET_GOLD_TT } text_single = { size = { 65 20 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_gold_ai_maa_ideal_budget_value')|1]" using = Font_Size_Small default_format = "#P" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_TARGET_GOLD_TT } text_single = { size = { 20 20 } text = SLTM_LVM_TREASURY_SHORT_MAX using = Font_Size_Small default_format = "#N" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_MAX_GOLD_TT } text_single = { size = { 70 20 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_gold_ai_maa_max_budget_value')|1]" using = Font_Size_Small default_format = "#N" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_MAX_GOLD_TT } }
            }
            vbox = {
                size = { @sltm_lvm_treasury_col_treasury @sltm_lvm_treasury_row_height } margin_top = 0 spacing = 1
                # R8.10：仅将国库财政三行数据块相对本行整体上移 5px；与私库财政使用完全相同的纵向偏移。
                hbox = {
                    visible = "[GetScriptedGui('sltm_lvm_treasury_has_treasury_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
                    size = { 100% 20 }
                    hbox = { size = { 60 20 } text_single = { size = { 16 20 } text = SLTM_LVM_TREASURY_SHORT_STOCK using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no tooltip = "[Character.GetTreasuryTooltipWithBalance]" } text_single = { size = { 44 20 } text = "[Character.GetTreasury|0]" using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no tooltip = "[Character.GetTreasuryTooltipWithBalance]" } }
                    hbox = { size = { 60 20 } text_single = { size = { 16 20 } text = SLTM_LVM_TREASURY_SHORT_IN using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_TREASURY_INCOME_TT } text_single = { size = { 44 20 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_income_value')|1]" using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_TREASURY_INCOME_TT } }
                    hbox = { size = { 60 20 } text_single = { size = { 16 20 } text = SLTM_LVM_TREASURY_SHORT_NET using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no tooltip = "[Character.GetTreasuryTooltipWithBalance]" } text_single = { size = { 44 20 } text = "[Character.GetTreasuryBalance|=+1]" using = Font_Size_Small align = left|nobaseline autoresize = no tooltip = "[Character.GetTreasuryTooltipWithBalance]" } }
                }
                hbox = { visible = "[GetScriptedGui('sltm_lvm_treasury_has_treasury_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 100% 20 } text_single = { size = { 20 20 } text = SLTM_LVM_TREASURY_SHORT_MIN using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_MIN_TREASURY_TT } text_single = { size = { 65 20 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_ai_maa_min_budget_value')|1]" using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_MIN_TREASURY_TT } text_single = { size = { 20 20 } text = SLTM_LVM_TREASURY_SHORT_NORMAL using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_NORMAL_TREASURY_TT } text_single = { size = { 70 20 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_actual_treasury_maa_expense_value')|2]" using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_NORMAL_TREASURY_TT } }
                hbox = { visible = "[GetScriptedGui('sltm_lvm_treasury_has_treasury_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 100% 20 } text_single = { size = { 20 20 } text = SLTM_LVM_TREASURY_SHORT_TARGET using = Font_Size_Small default_format = "#P" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_TARGET_TREASURY_TT } text_single = { size = { 65 20 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_ai_maa_ideal_budget_value')|1]" using = Font_Size_Small default_format = "#P" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_TARGET_TREASURY_TT } text_single = { size = { 20 20 } text = SLTM_LVM_TREASURY_SHORT_MAX using = Font_Size_Small default_format = "#N" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_MAX_TREASURY_TT } text_single = { size = { 70 20 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_ai_maa_max_budget_value')|1]" using = Font_Size_Small default_format = "#N" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_MAX_TREASURY_TT } }
                text_single = { visible = "[Not(GetScriptedGui('sltm_lvm_treasury_has_treasury_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]" size = { 100% 24 } text = SLTM_LVM_TREASURY_NO_TREASURY_SHORT using = Font_Size_Small default_format = "#low" align = center|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_NO_TREASURY_NOTE }
            }
            vbox = {
                size = { @sltm_lvm_treasury_col_budget @sltm_lvm_treasury_row_height } margin_top = 8 spacing = 2
                hbox = {
                    size = { 178 24 }
                    widget = {
                        size = { 89 24 }
                        state = { name = _mouse_enter on_start = "[InGameTopbar.ResetLastUpdateFrame]" }
                        tooltipwidget = { using = sltm_lvm_budget_direct_salary_probe_tooltip }
                        using = tooltip_ne
                        hbox = { size = { 89 24 } text_single = { size = { 22 24 } text = SLTM_LVM_TREASURY_BUDGET_SALARY_SHORT using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no alwaystransparent = yes } text_single = { size = { 67 24 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_budget_salary_central_candidate_probe_value')|1]" using = Font_Size_Small default_format = "#P" align = left|nobaseline autoresize = no alwaystransparent = yes } }
                    }
                    widget = {
                        size = { 89 24 }
                        state = { name = _mouse_enter on_start = "[InGameTopbar.ResetLastUpdateFrame]" }
                        tooltipwidget = { using = sltm_lvm_budget_direct_development_probe_tooltip }
                        using = tooltip_ne
                        hbox = { size = { 89 24 } text_single = { size = { 22 24 } text = SLTM_LVM_TREASURY_BUDGET_DEVELOPMENT_SHORT using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no alwaystransparent = yes } text_single = { size = { 67 24 } text = "[Multiply_CFixedPoint(Multiply_CFixedPoint(Character.MakeScope().ScriptValue('sltm_lvm_treasury_d21_taxable_rebuilt_candidate'), Character.GetVassalContract.GetTaxRatioForLiege), Character.MakeScope().ScriptValue('sltm_lvm_treasury_budget_development_vanilla_factor_probe_value'))|1]" using = Font_Size_Small default_format = "#P" align = left|nobaseline autoresize = no alwaystransparent = yes } }
                    }
                }
                hbox = {
                    size = { 178 24 }
                    widget = {
                        size = { 89 24 }
                        state = { name = _mouse_enter on_start = "[InGameTopbar.ResetLastUpdateFrame]" }
                        tooltipwidget = { using = sltm_lvm_budget_direct_military_probe_tooltip }
                        using = tooltip_ne
                        hbox = { size = { 89 24 } text_single = { size = { 22 24 } text = SLTM_LVM_TREASURY_BUDGET_MILITARY_SHORT using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no alwaystransparent = yes } text_single = { size = { 67 24 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_budget_military_central_candidate_probe_value')|1]" using = Font_Size_Small default_format = "#P" align = left|nobaseline autoresize = no alwaystransparent = yes } }
                    }
                    widget = {
                        size = { 89 24 }
                        state = { name = _mouse_enter on_start = "[InGameTopbar.ResetLastUpdateFrame]" }
                        tooltipwidget = { using = sltm_lvm_budget_direct_ministry_probe_tooltip }
                        using = tooltip_ne
                        hbox = { size = { 89 24 } text_single = { size = { 22 24 } text = SLTM_LVM_TREASURY_BUDGET_COURTIER_SHORT using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no alwaystransparent = yes } text_single = { size = { 67 24 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_budget_ministry_central_candidate_probe_value')|1]" using = Font_Size_Small default_format = "#P" align = left|nobaseline autoresize = no alwaystransparent = yes } }
                    }
                }
            }
            widget = {
                size = { @sltm_lvm_treasury_col_fixed_grant @sltm_lvm_treasury_row_height }
                text_single = { parentanchor = center size = { 100% 24 } visible = "[And(GetScriptedGui('sltm_lvm_treasury_is_junfu_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End), GetScriptedGui('sltm_lvm_treasury_probe_20_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]" raw_text = "+20/月" using = Font_Size_Small default_format = "#P" align = center|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_FIXED_GRANT_TT }
                text_single = { parentanchor = center size = { 100% 24 } visible = "[And(And(GetScriptedGui('sltm_lvm_treasury_is_junfu_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End), Not(GetScriptedGui('sltm_lvm_treasury_probe_20_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End))), GetScriptedGui('sltm_lvm_treasury_probe_10_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]" raw_text = "+10/月" using = Font_Size_Small default_format = "#P" align = center|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_FIXED_GRANT_TT }
                text_single = { parentanchor = center size = { 100% 24 } visible = "[And(And(GetScriptedGui('sltm_lvm_treasury_is_junfu_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End), Not(GetScriptedGui('sltm_lvm_treasury_probe_20_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End))), Not(GetScriptedGui('sltm_lvm_treasury_probe_10_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)))]" raw_text = "0/月" using = Font_Size_Small default_format = "#low" align = center|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_FIXED_GRANT_TT }
                text_single = { parentanchor = center size = { 100% 24 } visible = "[Not(GetScriptedGui('sltm_lvm_treasury_is_junfu_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]" raw_text = "—" using = Font_Size_Small default_format = "#low" align = center|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_FIXED_GRANT_TT }
            }
        }
    }
}

############################################################
# R7：右侧“持有者的全部头衔”恢复早期整行按钮。
# 此小列表没有第二种行内交互，不与左侧主列表共享局部点击热区。
# 整个 340×44 框负责切换到头衔页并选中对应头衔。
############################################################
template sltm_lvm_selected_holder_title_item
{
    button_standard_list = {
        size = { 340 44 }
        datacontext = "[Scope.Title]"
        onclick = "[GetVariableSystem.Set('sltm_lvm_tabs', 'titles')]"
        onclick = "[GetScriptedGui('sltm_lvm_select_title_gui').Execute(GuiScope.SetRoot(Scope.Title.MakeScope).AddScope('player', GetPlayer.MakeScope).End)]"
        onrightclick = "[DefaultOnCoatOfArmsRightClick(Title.GetID)]"
        tooltipwidget = { using = LandedTitleTooltip }

        hbox = {
            spacing = 5
            widget = {
                size = { 46 100% }
                coa_title_tiny_crown = { parentanchor = center scale = 0.85 }
            }
            vbox = {
                size = { 208 100% }
                margin_top = 5
                spacing = 1
                text_single = { size = { 202 22 } text = "[Title.GetNameWithUnderlyingNoTooltip]" using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no alwaystransparent = yes }
                text_single = { size = { 202 18 } text = TV_TIER_INFO using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no alwaystransparent = yes }
            }
            vbox = {
                size = { 70 100% }
                margin_top = 6
                text_single = { visible = "[Title.MakeScope.Var('mytm_junfu_handover_blocked').IsSet]" text = SLTM_LVM_STATUS_BLOCKED using = Font_Size_Small default_format = "#N" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_STATUS_BLOCKED_TT }
                text_single = { visible = "[And(Not(Title.MakeScope.Var('mytm_junfu_handover_blocked').IsSet), Title.MakeScope.Var('mytm_reassign_pending').IsSet)]" text = SLTM_LVM_STATUS_PENDING using = Font_Size_Small default_format = "#P" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_STATUS_PENDING_TT }
                text_single = { visible = "[And(And(Not(Title.MakeScope.Var('mytm_junfu_handover_blocked').IsSet), Not(Title.MakeScope.Var('mytm_reassign_pending').IsSet)), ObjectsEqual(Title.GetHolder.GetPrimaryTitle, Title.Self))]" text = SLTM_LVM_FILTER_STATUS_PRIMARY using = Font_Size_Small align = left|nobaseline autoresize = no tooltip = SLTM_LVM_STATUS_PRIMARY_TT }
                text_single = { visible = "[And(And(Not(Title.MakeScope.Var('mytm_junfu_handover_blocked').IsSet), Not(Title.MakeScope.Var('mytm_reassign_pending').IsSet)), Not(ObjectsEqual(Title.GetHolder.GetPrimaryTitle, Title.Self)))]" text = SLTM_LVM_FILTER_STATUS_CONCURRENT using = Font_Size_Small align = left|nobaseline autoresize = no tooltip = SLTM_LVM_STATUS_CONCURRENT_TT }
            }
        }
    }
}
