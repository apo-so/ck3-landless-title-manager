                                    }
                                }
                                expand = {}
                            }

                            divider = { size = { 330 2 } }
                            text_single = { size = { 330 28 } text = SLTM_LVM_TREASURY_SECTION_PRIVATE using = Font_Size_Medium align = left|nobaseline autoresize = no }
                            hbox = { size = { 330 28 } text_single = { size = { 155 28 } text = SLTM_LVM_TREASURY_GOLD_STOCK using = Font_Size_Small align = left|nobaseline autoresize = no } expand = {} text_single = { size = { 110 28 } text = "[Character.GetGold|0]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no tooltip = "[Character.GetGoldTooltipWithBalance]" } }
                            hbox = { size = { 330 28 } text_single = { size = { 155 28 } text = SLTM_LVM_TREASURY_MONTHLY_INCOME using = Font_Size_Small align = left|nobaseline autoresize = no } expand = {} text_single = { size = { 110 28 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_private_income_value')|1]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_PRIVATE_INCOME_TT } }
                            hbox = { size = { 330 28 } text_single = { size = { 155 28 } text = SLTM_LVM_TREASURY_MONTHLY_EXPENSES using = Font_Size_Small align = left|nobaseline autoresize = no } expand = {} text_single = { size = { 110 28 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_private_expenses_value')|1]" using = Font_Size_Small default_format = "#N" align = right|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_PRIVATE_EXPENSES_TT } }
                            hbox = { size = { 330 28 } text_single = { size = { 155 28 } text = SLTM_LVM_TREASURY_MONTHLY_NET using = Font_Size_Small align = left|nobaseline autoresize = no } expand = {} text_single = { size = { 110 28 } text = "[Character.GetBalance|=+1]" using = Font_Size_Small align = right|nobaseline autoresize = no tooltip = "[Character.GetGoldTooltipWithBalance]" } }

                            divider = { size = { 330 2 } }
                            text_single = { size = { 330 28 } text = SLTM_LVM_TREASURY_SECTION_TREASURY using = Font_Size_Medium align = left|nobaseline autoresize = no }
                            hbox = { visible = "[GetScriptedGui('sltm_lvm_treasury_has_treasury_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 330 28 } text_single = { size = { 155 28 } text = SLTM_LVM_TREASURY_STOCK using = Font_Size_Small align = left|nobaseline autoresize = no } expand = {} text_single = { size = { 110 28 } text = "[Character.GetTreasury|0]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no tooltip = "[Character.GetTreasuryTooltipWithBalance]" } }
                            hbox = { visible = "[GetScriptedGui('sltm_lvm_treasury_has_treasury_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 330 28 } text_single = { size = { 155 28 } text = SLTM_LVM_TREASURY_MONTHLY_INCOME using = Font_Size_Small align = left|nobaseline autoresize = no } expand = {} text_single = { size = { 110 28 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_income_value')|1]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_TREASURY_INCOME_TT } }
                            hbox = { visible = "[GetScriptedGui('sltm_lvm_treasury_has_treasury_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 330 28 } text_single = { size = { 155 28 } text = SLTM_LVM_TREASURY_MONTHLY_NET using = Font_Size_Small align = left|nobaseline autoresize = no } expand = {} text_single = { size = { 110 28 } text = "[Character.GetTreasuryBalance|=+1]" using = Font_Size_Small align = right|nobaseline autoresize = no tooltip = "[Character.GetTreasuryTooltipWithBalance]" } }
                            text_single = { visible = "[Not(GetScriptedGui('sltm_lvm_treasury_has_treasury_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]" size = { 330 28 } text = SLTM_LVM_TREASURY_NO_TREASURY_SHORT using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_NO_TREASURY_NOTE }

                            divider = { size = { 330 2 } }
                            text_single = { size = { 330 28 } text = SLTM_LVM_TREASURY_SECTION_CENTRAL_BUDGETS using = Font_Size_Medium align = left|nobaseline autoresize = no }
                            hbox = {
                                size = { 330 28 }
                                text_single = { size = { 92 28 } text = SLTM_LVM_TREASURY_RIGHT_SALARY using = Font_Size_Small align = left|nobaseline autoresize = no }
                                text_single = { size = { 18 28 } text = SLTM_LVM_TREASURY_RIGHT_SEND using = Font_Size_Small default_format = "#low" align = center|nobaseline autoresize = no }
                                text_single = { size = { 72 28 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_budget_salary_central_candidate_probe_value')|2]" using = Font_Size_Small default_format = "#P" align = right|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_BUDGET_SALARY_TT }
                                text_single = { size = { 18 28 } text = SLTM_LVM_TREASURY_RIGHT_RECEIVE using = Font_Size_Small default_format = "#low" align = center|nobaseline autoresize = no }
                                text_single = { size = { 95 28 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_budget_salary_receipt_value')|3]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no tooltip = "[Character.GetGoldTooltipWithBalance]" }
                                expand = {}
                            }
                            hbox = {
                                size = { 330 28 }
                                text_single = { size = { 92 28 } text = SLTM_LVM_TREASURY_RIGHT_DEVELOPMENT using = Font_Size_Small align = left|nobaseline autoresize = no }
                                text_single = { size = { 18 28 } text = SLTM_LVM_TREASURY_RIGHT_SEND using = Font_Size_Small default_format = "#low" align = center|nobaseline autoresize = no }
                                text_single = { size = { 72 28 } text = "[Multiply_CFixedPoint(Multiply_CFixedPoint(Character.MakeScope().ScriptValue('sltm_lvm_treasury_d21_taxable_rebuilt_candidate'), Character.GetVassalContract.GetTaxRatioForLiege), Character.MakeScope().ScriptValue('sltm_lvm_treasury_budget_development_vanilla_factor_probe_value'))|2]" using = Font_Size_Small default_format = "#P" align = right|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_BUDGET_DEVELOPMENT_TT }
                                text_single = { size = { 18 28 } text = SLTM_LVM_TREASURY_RIGHT_RECEIVE using = Font_Size_Small default_format = "#low" align = center|nobaseline autoresize = no }
                                # D28：封臣发展金是同一笔 liege -> vassal Treasury 转移。D4 用户实机已见天子 -45.6 / 李参 +45.6；
                                # monthly_treasury_from_liege_mult 已包含在上方 factor，固定拨款 monthly_treasury_from_liege_add 仍独立列。
                                text_single = { size = { 95 28 } text = "[Multiply_CFixedPoint(Multiply_CFixedPoint(Character.MakeScope().ScriptValue('sltm_lvm_treasury_d21_taxable_rebuilt_candidate'), Character.GetVassalContract.GetTaxRatioForLiege), Character.MakeScope().ScriptValue('sltm_lvm_treasury_budget_development_vanilla_factor_probe_value'))|3]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no tooltip = "[Character.GetTreasuryTooltipWithBalance]" }
                                expand = {}
                            }
                            hbox = {
                                size = { 330 28 }
                                text_single = { size = { 92 28 } text = SLTM_LVM_TREASURY_RIGHT_MILITARY using = Font_Size_Small align = left|nobaseline autoresize = no }
                                text_single = { size = { 18 28 } text = SLTM_LVM_TREASURY_RIGHT_SEND using = Font_Size_Small default_format = "#low" align = center|nobaseline autoresize = no }
                                text_single = { size = { 72 28 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_budget_military_central_candidate_probe_value')|2]" using = Font_Size_Small default_format = "#P" align = right|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_BUDGET_MILITARY_TT }
                                text_single = { size = { 18 28 } text = SLTM_LVM_TREASURY_RIGHT_RECEIVE using = Font_Size_Small default_format = "#low" align = center|nobaseline autoresize = no }
                                widget = {
                                    size = { 95 28 }
                                    # D27：行政制“军需官/Army Quartermasters”原版没有 script parameter，
                                    # 但 GUI 暴露 typed HouseAspiration + 0-based level index。这里按原版 +5/+10/+15% 自动选择。
                                    datacontext = "[Character.GetHouse]"
                                    widget = {
                                        size = { 95 28 }
                                        visible = "[Or(Not(ObjectsEqual(DynastyHouse.GetHouseAspiration.Self, GetHouseAspiration('army_quartermasters'))), DynastyHouse.IsHouseAttributeInactive)]"
                                        text_single = { size = { 95 28 } datacontext = "[GetPlayer.MakeScope.Var('sltm_lvm_treasury_selected_character').Char]" text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_budget_military_receipt_value')|3]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no tooltip = "[Character.GetTreasuryTooltipWithBalance]" }
                                    }
                                    widget = {
                                        size = { 95 28 }
                                        visible = "[And(And(ObjectsEqual(DynastyHouse.GetHouseAspiration.Self, GetHouseAspiration('army_quartermasters')), Not(DynastyHouse.IsHouseAttributeInactive)), EqualTo_int32(DynastyHouse.GetHouseAspirationLevelIndex, '(int32)0'))]"
                                        text_single = { size = { 95 28 } datacontext = "[GetPlayer.MakeScope.Var('sltm_lvm_treasury_selected_character').Char]" text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_d26_military_receipt_admin_qm_l1')|3]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no tooltip = "[Character.GetTreasuryTooltipWithBalance]" }
                                    }
                                    widget = {
                                        size = { 95 28 }
                                        visible = "[And(And(ObjectsEqual(DynastyHouse.GetHouseAspiration.Self, GetHouseAspiration('army_quartermasters')), Not(DynastyHouse.IsHouseAttributeInactive)), EqualTo_int32(DynastyHouse.GetHouseAspirationLevelIndex, '(int32)1'))]"
                                        text_single = { size = { 95 28 } datacontext = "[GetPlayer.MakeScope.Var('sltm_lvm_treasury_selected_character').Char]" text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_d26_military_receipt_admin_qm_l2')|3]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no tooltip = "[Character.GetTreasuryTooltipWithBalance]" }
                                    }
                                    widget = {
                                        size = { 95 28 }
                                        visible = "[And(And(ObjectsEqual(DynastyHouse.GetHouseAspiration.Self, GetHouseAspiration('army_quartermasters')), Not(DynastyHouse.IsHouseAttributeInactive)), EqualTo_int32(DynastyHouse.GetHouseAspirationLevelIndex, '(int32)2'))]"
                                        text_single = { size = { 95 28 } datacontext = "[GetPlayer.MakeScope.Var('sltm_lvm_treasury_selected_character').Char]" text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_d26_military_receipt_admin_qm_l3')|3]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no tooltip = "[Character.GetTreasuryTooltipWithBalance]" }
                                    }
                                }
                                expand = {}
                            }
                            hbox = {
                                size = { 330 28 }
                                text_single = { size = { 92 28 } text = SLTM_LVM_TREASURY_RIGHT_MINISTRY using = Font_Size_Small align = left|nobaseline autoresize = no }
                                text_single = { size = { 18 28 } text = SLTM_LVM_TREASURY_RIGHT_SEND using = Font_Size_Small default_format = "#low" align = center|nobaseline autoresize = no }
                                text_single = { size = { 72 28 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_budget_ministry_central_candidate_probe_value')|2]" using = Font_Size_Small default_format = "#P" align = right|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_BUDGET_COURTIER_TT }
                                text_single = { size = { 18 28 } text = SLTM_LVM_TREASURY_RIGHT_RECEIVE using = Font_Size_Small default_format = "#low" align = center|nobaseline autoresize = no }
                                text_single = { size = { 95 28 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_budget_ministry_receipt_value')|3]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no tooltip = "[Character.GetTreasuryTooltipWithBalance]" }
                                expand = {}
                            }
                            text_multi = { layoutpolicy_horizontal = expanding text = SLTM_LVM_TREASURY_RIGHT_BUDGET_NOTE using = Font_Size_Small default_format = "#low" autoresize = yes max_width = 330 align = left }

                            divider = { size = { 330 2 } }
                            text_single = { size = { 330 28 } text = SLTM_LVM_TREASURY_SECTION_CENTRAL using = Font_Size_Medium align = left|nobaseline autoresize = no }
                            hbox = { size = { 330 28 } text_single = { size = { 155 28 } text = SLTM_LVM_TREASURY_CENTRAL_CURRENT using = Font_Size_Small align = left|nobaseline autoresize = no } expand = {} text_single = { visible = "[And(GetScriptedGui('sltm_lvm_treasury_is_junfu_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End), GetScriptedGui('sltm_lvm_treasury_probe_20_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]" size = { 110 28 } text = SLTM_LVM_TREASURY_STIPEND_20 using = Font_Size_Small default_format = "#P" align = right|nobaseline autoresize = no } text_single = { visible = "[And(And(GetScriptedGui('sltm_lvm_treasury_is_junfu_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End), Not(GetScriptedGui('sltm_lvm_treasury_probe_20_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End))), GetScriptedGui('sltm_lvm_treasury_probe_10_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]" size = { 110 28 } text = SLTM_LVM_TREASURY_STIPEND_10 using = Font_Size_Small default_format = "#P" align = right|nobaseline autoresize = no } text_single = { visible = "[And(And(GetScriptedGui('sltm_lvm_treasury_is_junfu_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End), Not(GetScriptedGui('sltm_lvm_treasury_probe_20_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End))), Not(GetScriptedGui('sltm_lvm_treasury_probe_10_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)))]" size = { 110 28 } text = SLTM_LVM_TREASURY_STIPEND_ZERO using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no } text_single = { visible = "[Not(GetScriptedGui('sltm_lvm_treasury_is_junfu_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]" size = { 110 28 } text = SLTM_LVM_TREASURY_NOT_APPLICABLE using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no } }
                            text_multi = { visible = "[GetScriptedGui('sltm_lvm_treasury_is_junfu_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" layoutpolicy_horizontal = expanding text = SLTM_LVM_TREASURY_PROBE_NOTE using = Font_Size_Small default_format = "#low" autoresize = yes max_width = 330 align = left }
                            hbox = { visible = "[GetScriptedGui('sltm_lvm_treasury_is_junfu_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 330 30 } spacing = 6   }
                            hbox = { visible = "[GetScriptedGui('sltm_lvm_treasury_is_junfu_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 330 30 } spacing = 6   }
