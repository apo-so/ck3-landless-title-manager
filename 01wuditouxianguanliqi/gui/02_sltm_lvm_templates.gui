############################################################
# R8-B2P4D26 — 三预算实际到账：全部可枚举来源重建矩阵。
# D25 typed Character getter / 无后缀 numeric route 已由多角色实机判死。
# 本 tooltip 只显示：中央发放、各来源 multiplier、完整候选，以及原版完整财务明细作真值。
############################################################
template sltm_lvm_d26_receipt_matrix_tooltip
{
    container = {
        size = { 716 470 }
        alwaystransparent = no

        widget = {
            name = "background"
            size = { 100% 100% }
            alwaystransparent = no
            using = DefaultTooltipBackground
        }

        vbox = {
            size = { 716 470 }
            margin = { 12 8 }
            spacing = 3

            text_single = { size = { 692 28 } text = SLTM_LVM_TREASURY_D26_TITLE using = Font_Size_Medium default_format = "#T" align = center|nobaseline autoresize = no }
            hbox = {
                size = { 692 24 }
                text_single = { size = { 100 24 } text = SLTM_LVM_TREASURY_D26_TARGET using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                text_single = { size = { 392 24 } text = "[Character.GetUIName]" using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no elide = right }
                container = {
                    size = { 200 24 }
                    datacontext = "[Character.GetHouse]"
                    text_single = { size = { 160 24 } text = "[DynastyHouse.GetHouseAspiration.GetName]" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no elide = right }
                    text_single = { position = { 164 0 } size = { 36 24 } raw_text = "L[DynastyHouse.GetHouseAspirationLevelIndex]" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                }
            }

            hbox = {
                size = { 692 26 }
                text_single = { size = { 78 26 } text = SLTM_LVM_TREASURY_D26_SUMMARY using = Font_Size_Small default_format = "#T" align = left|nobaseline autoresize = no }
                text_single = { size = { 190 26 } raw_text = "俸 [Character.MakeScope().ScriptValue('sltm_lvm_treasury_budget_salary_central_candidate_probe_value')|3] → [Character.MakeScope().ScriptValue('sltm_lvm_treasury_d26_salary_receipt_candidate')|3]" using = Font_Size_Small default_format = "#P" align = right|nobaseline autoresize = no tooltip = "[Character.GetGoldTooltipWithBalance]" }
                text_single = { size = { 205 26 } raw_text = "军 [Character.MakeScope().ScriptValue('sltm_lvm_treasury_budget_military_central_candidate_probe_value')|3] → [Character.MakeScope().ScriptValue('sltm_lvm_treasury_d26_military_receipt_known_candidate')|3]" using = Font_Size_Small default_format = "#P" align = right|nobaseline autoresize = no tooltip = "[Character.GetTreasuryTooltipWithBalance]" }
                text_single = { size = { 205 26 } raw_text = "臣 [Character.MakeScope().ScriptValue('sltm_lvm_treasury_budget_ministry_central_candidate_probe_value')|3] → [Character.MakeScope().ScriptValue('sltm_lvm_treasury_d26_ministry_receipt_candidate')|3]" using = Font_Size_Small default_format = "#P" align = right|nobaseline autoresize = no tooltip = "[Character.GetTreasuryTooltipWithBalance]" }
                expand = {}
            }

            divider = { size = { 692 2 } }

            # Salary
            text_single = { size = { 692 24 } text = SLTM_LVM_TREASURY_D26_SALARY_HEADER using = Font_Size_Small default_format = "#T" align = left|nobaseline autoresize = no }
            hbox = {
                size = { 692 24 }
                text_single = { size = { 100 24 } raw_text = "契约" using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                text_single = { size = { 72 24 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_d26_salary_contract_mult')|1%]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no }
                text_single = { size = { 92 24 } raw_text = "庄园20项" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                text_single = { size = { 72 24 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_d26_salary_estate_mult')|1%]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no }
                text_single = { size = { 82 24 } raw_text = "家族抱负" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                text_single = { size = { 72 24 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_d26_salary_celestial_family_mult')|1%]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no }
                text_single = { size = { 90 24 } raw_text = "细账" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                text_single = { size = { 72 24 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_d26_salary_detailed_ledgers_mult')|1%]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no }
                expand = {}
            }
            hbox = {
                size = { 692 24 }
                text_single = { size = { 100 24 } raw_text = "临时修正" using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                text_single = { size = { 72 24 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_d26_salary_named_modifier_mult')|1%]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no }
                text_single = { size = { 92 24 } raw_text = "个人荣典" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                text_single = { size = { 72 24 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_d26_salary_personal_honors_mult')|1%]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no }
                text_single = { size = { 82 24 } raw_text = "总倍率" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                text_single = { size = { 72 24 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_d26_salary_total_mult')|1%]" using = Font_Size_Small default_format = "#P" align = right|nobaseline autoresize = no }
                text_single = { size = { 90 24 } raw_text = "旧D19" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                text_single = { size = { 112 24 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_d19_salary_recipient_candidate')|3]" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                expand = {}
            }

            divider = { size = { 692 2 } }

            # Military
            text_single = { size = { 692 24 } text = SLTM_LVM_TREASURY_D26_MILITARY_HEADER using = Font_Size_Small default_format = "#T" align = left|nobaseline autoresize = no }
            hbox = {
                size = { 692 24 }
                text_single = { size = { 100 24 } raw_text = "庄园38项" using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                text_single = { size = { 72 24 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_d24_military_estate_mult')|1%]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no }
                text_single = { size = { 92 24 } raw_text = "天朝武勋" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                text_single = { size = { 72 24 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_d24_military_celestial_house_mult')|1%]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no }
                text_single = { size = { 82 24 } raw_text = "大征伐" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                text_single = { size = { 72 24 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_d24_military_dynastic_mult')|1%]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no }
                text_single = { size = { 90 24 } raw_text = "总已知" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                text_single = { size = { 72 24 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_d26_military_total_known_mult')|1%]" using = Font_Size_Small default_format = "#P" align = right|nobaseline autoresize = no }
                expand = {}
            }
            hbox = {
                size = { 692 24 }
                text_single = { size = { 150 24 } text = SLTM_LVM_TREASURY_D26_ADMIN_QM using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                text_single = { size = { 150 24 } raw_text = "L1 [Character.MakeScope().ScriptValue('sltm_lvm_treasury_d26_military_receipt_admin_qm_l1')|3]" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                text_single = { size = { 150 24 } raw_text = "L2 [Character.MakeScope().ScriptValue('sltm_lvm_treasury_d26_military_receipt_admin_qm_l2')|3]" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                text_single = { size = { 150 24 } raw_text = "L3 [Character.MakeScope().ScriptValue('sltm_lvm_treasury_d26_military_receipt_admin_qm_l3')|3]" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                expand = {}
            }

            divider = { size = { 692 2 } }

            # Ministry
            text_single = { size = { 692 24 } text = SLTM_LVM_TREASURY_D26_MINISTRY_HEADER using = Font_Size_Small default_format = "#T" align = left|nobaseline autoresize = no }
            hbox = {
                size = { 692 24 }
                text_single = { size = { 126 24 } raw_text = "官僚职位适性" using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                text_single = { size = { 86 24 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_d24_ministry_bureaucrat_mult')|1%]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no }
                text_single = { size = { 126 24 } raw_text = "个人荣典" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                text_single = { size = { 86 24 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_d24_ministry_personal_honors_mult')|1%]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no }
                text_single = { size = { 126 24 } raw_text = "总倍率" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                text_single = { size = { 86 24 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_d26_ministry_total_mult')|1%]" using = Font_Size_Small default_format = "#P" align = right|nobaseline autoresize = no }
                expand = {}
            }

            divider = { size = { 692 2 } }
            textbox = { size = { 692 94 } multiline = yes text = SLTM_LVM_TREASURY_D26_CRITERIA using = Font_Size_Small default_format = "#low" align = left fonttintcolor = "[TooltipInfo.GetTintColor]" }
        }
    }
}

window = {
    name = "sltm_lvm_window"
    widgetid = "sltm_lvm_window"
    datacontext = "[GetPlayer]"
    datacontext = "[GetVariableSystem]"
    parentanchor = center
    size = { 1540 800 }
    layer = windows_layer
    filter_mouse = all
    allow_outside = yes
    alwaystransparent = no

    using = Window_Movable
    using = Window_Background
    using = Window_Decoration

    visible = no # 旧窗口实例也遵从总览暂停开放。

    state = {
        name = _show
        using = Animation_FadeIn_Quick
        using = Sound_WindowShow_Standard
        on_start = "[PdxGuiWidget.StackTop]"
        on_start = "[GetVariableSystem.Set('sltm_lvm_tabs', 'titles')]"
        # 在任何筛选按钮求值前补齐旧存档可能缺失的 hf_* 状态。
        on_start = "[GetScriptedGui('sltm_lvm_prepare_holder_filter_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        # 弹层属于 GUI 临时状态；重新打开时不能继承上次关闭前的遮挡层。
        # 双对象筛选：分别关闭两个筛选窗与排序菜单；保留持久筛选/排序条件。
        on_start = "[GetVariableSystem.Clear('sltm_lvm_title_filters_open')]"
        on_start = "[GetVariableSystem.Clear('sltm_lvm_holder_filters_open')]"
        on_start = "[GetVariableSystem.Clear('sltm_lvm_treasury_filters_open')]"
        on_start = "[GetVariableSystem.Clear('sltm_lvm_sort_menu_open')]"
        on_start = "[GetVariableSystem.Clear('sltm_lvm_dropdown_open')]"
        # 头衔筛选窗分组默认全部展开
        on_start = "[GetVariableSystem.Set('sltm_lvm_title_filter_group_type_open', 'yes')]"
        on_start = "[GetVariableSystem.Set('sltm_lvm_title_filter_group_creation_open', 'yes')]"
        on_start = "[GetVariableSystem.Set('sltm_lvm_title_filter_group_tier_open', 'yes')]"
        on_start = "[GetVariableSystem.Set('sltm_lvm_title_filter_group_status_open', 'yes')]"
        on_start = "[GetVariableSystem.Set('sltm_lvm_title_filter_group_role_open', 'yes')]"
        on_start = "[GetVariableSystem.Set('sltm_lvm_title_filter_group_holder_open', 'yes')]"
        # 封臣筛选窗默认展开"管理"与"基础"；Exists 语义下折叠必须 Clear，不能写 no。
        on_start = "[GetVariableSystem.Set('sltm_lvm_holder_filter_group_manage_open', 'yes')]"
        on_start = "[GetVariableSystem.Set('sltm_lvm_holder_filter_group_basic_open', 'yes')]"
        on_start = "[GetVariableSystem.Clear('sltm_lvm_holder_filter_group_ability_open')]"
        on_start = "[GetVariableSystem.Clear('sltm_lvm_holder_filter_group_faith_culture_dynasty_open')]"
        on_start = "[GetVariableSystem.Clear('sltm_lvm_holder_filter_group_identity_special_open')]"
        on_start = "[GetVariableSystem.Clear('sltm_lvm_holder_filter_group_trait_edu_genetic_open')]"
    }

    state = {
        name = _hide
        using = Animation_FadeOut_Quick
        using = Sound_WindowHide_Standard
    }

    vbox = {
        using = Window_Margins
        size = { 100% 100% }
        spacing = 6

        header_pattern = {
            layoutpolicy_horizontal = expanding

            blockoverride "header_text" {
                text = SLTM_LVM_TITLE
            }

            blockoverride "button_close" {
                onclick = "[GetVariableSystem.Clear('sltm_lvm_title_filters_open')]"
                onclick = "[GetVariableSystem.Clear('sltm_lvm_holder_filters_open')]"
                onclick = "[GetVariableSystem.Clear('sltm_lvm_treasury_filters_open')]"
                onclick = "[GetVariableSystem.Clear('sltm_lvm_sort_menu_open')]"
                onclick = "[GetScriptedGui('sltm_lvm_close_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            }
        }

        hbox = {
            layoutpolicy_horizontal = expanding
            size = { 100% 36 }
            spacing = 6

            button_standard = { size = { 110 30 } text = sltm_w_create enabled = "[GetScriptedGui('sltm_workflow_create_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('sltm_workflow_create_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            button_standard = { size = { 165 30 } text = sltm_w_ensure enabled = "[GetScriptedGui('sltm_workflow_ensure_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('sltm_workflow_ensure_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
            # 双对象筛选：两个互相独立、按当前页显示的筛选按钮（重叠摆放）。
            button_standard = {
                name = "title_filter_button"
                size = { 25 25 }
                visible = "[GetVariableSystem.HasValue('sltm_lvm_tabs', 'titles')]"
                onclick = "[GetScriptedGui('sltm_lvm_prepare_title_multiselect_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onclick = "[GetVariableSystem.Toggle('sltm_lvm_title_filters_open')]"
                down = "[GetVariableSystem.Exists('sltm_lvm_title_filters_open')]"
                frame = "[BoolTo1And2(Not(GetScriptedGui('sltm_lvm_title_multiselect_active_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]"
                tooltip = SLTM_LVM_TOGGLE_FILTERS_TT
                using = tooltip_nw

                button_search = {
                    # 与角色搜索器相同：图标只负责显示，点击交给外层筛选按钮。
                    alwaystransparent = yes
                    parentanchor = center
                    size = { 20 20 }
                }
            }
            button_standard = {
                name = "holder_filter_button"
                size = { 25 25 }
                visible = "[Or(GetVariableSystem.HasValue('sltm_lvm_tabs', 'holders'), GetVariableSystem.HasValue('sltm_lvm_tabs', 'treasury'))]"
                onclick = "[GetScriptedGui('sltm_lvm_prepare_holder_filter_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                onclick = "[GetVariableSystem.Toggle('sltm_lvm_holder_filters_open')]"
                onclick = "[GetVariableSystem.Clear('sltm_lvm_dropdown_open')]"
                down = "[GetVariableSystem.Exists('sltm_lvm_holder_filters_open')]"
                frame = "[BoolTo1And2(Not(GetScriptedGui('sltm_lvm_v36_filters_active_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]"
                tooltip = SLTM_LVM_TOGGLE_FILTERS_TT
                using = tooltip_nw

                button_search = {
                    alwaystransparent = yes
                    parentanchor = center
                    size = { 20 20 }
                }
            }
            button_standard = {
                name = "treasury_filter_button"
                size = { 25 25 }
                # R10-35A0: canonical 直显验证阶段，筛选器不参与数据裁切。
                visible = no
                onclick = "[GetVariableSystem.Toggle('sltm_lvm_treasury_filters_open')]"
                down = "[GetVariableSystem.Exists('sltm_lvm_treasury_filters_open')]"
                frame = "[BoolTo1And2(Not(GetScriptedGui('sltm_lvm_treasury_filters_active_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]"
                tooltip = SLTM_LVM_TOGGLE_FILTERS_TT
                using = tooltip_nw
                button_search = { alwaystransparent = yes parentanchor = center size = { 20 20 } }
            }

            button_replace = {
                size = { 25 25 }
                visible = "[And(GetVariableSystem.HasValue('sltm_lvm_tabs', 'titles'), GetScriptedGui('sltm_lvm_title_multiselect_active_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
                onclick = "[GetScriptedGui('sltm_lvm_title_multiselect_reset_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                tooltip = SLTM_LVM_RESET_FILTERS
                using = tooltip_nw
            }
            button_replace = {
                size = { 25 25 }
                visible = "[And(Or(GetVariableSystem.HasValue('sltm_lvm_tabs', 'holders'), GetVariableSystem.HasValue('sltm_lvm_tabs', 'treasury')), GetScriptedGui('sltm_lvm_v36_filters_active_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
                onclick = "[GetScriptedGui('sltm_lvm_v36_reset_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                tooltip = SLTM_LVM_RESET_FILTERS
                using = tooltip_nw
            }
            button_replace = {
                size = { 25 25 }
                visible = no
                onclick = "[GetScriptedGui('sltm_lvm_treasury_reset_filters_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                tooltip = SLTM_LVM_RESET_FILTERS
                using = tooltip_nw
            }

            divider_light = { size = { 3 20 } }

            text_single = { text = SLTM_LVM_SORT_BY_LABEL using = Font_Size_Small align = nobaseline }

            # 原版 dropdown 需要 C++ DataModel；这里采用根层真实弹层，按钮始终显示当前字段。
            button_standard = {
                name = "title_sort_field"
                size = { 170 32 }
                visible = "[GetVariableSystem.HasValue('sltm_lvm_tabs', 'titles')]"
                onclick = "[GetVariableSystem.Toggle('sltm_lvm_sort_menu_open')]"
                down = "[GetVariableSystem.Exists('sltm_lvm_sort_menu_open')]"
                tooltip = SLTM_LVM_SORT_MENU
                using = tooltip_nw

                # UI006: native button text with player-scoped scripted localization.
                text = "[GetPlayer.Custom('sltm_lvm_title_sort_caption')]"
            }

            button_standard = {
                name = "holder_sort_field"
                size = { 170 32 }
                visible = "[Or(GetVariableSystem.HasValue('sltm_lvm_tabs', 'holders'), GetVariableSystem.HasValue('sltm_lvm_tabs', 'treasury'))]"
                onclick = "[GetVariableSystem.Toggle('sltm_lvm_sort_menu_open')]"
                down = "[GetVariableSystem.Exists('sltm_lvm_sort_menu_open')]"
                tooltip = SLTM_LVM_SORT_MENU
                using = tooltip_nw

                text_single = { parentanchor = center visible = "[ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_holder_sort').GetFlagName, 'managed_count')]" text = SLTM_LVM_SORT_HOLDER_COUNT align = center|nobaseline alwaystransparent = yes }
                text_single = { parentanchor = center visible = "[ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_holder_sort').GetFlagName, 'rank')]" text = SLTM_LVM_SORT_HOLDER_RANK align = center|nobaseline alwaystransparent = yes }
                text_single = { parentanchor = center visible = "[ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_holder_sort').GetFlagName, 'age')]" text = SLTM_LVM_SORT_HOLDER_AGE align = center|nobaseline alwaystransparent = yes }
                text_single = { parentanchor = center visible = "[ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_holder_sort').GetFlagName, 'diplomacy')]" text = SLTM_LVM_SORT_HOLDER_DIPLOMACY align = center|nobaseline alwaystransparent = yes }
                text_single = { parentanchor = center visible = "[ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_holder_sort').GetFlagName, 'martial')]" text = SLTM_LVM_SORT_HOLDER_MARTIAL align = center|nobaseline alwaystransparent = yes }
                text_single = { parentanchor = center visible = "[ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_holder_sort').GetFlagName, 'stewardship')]" text = SLTM_LVM_SORT_HOLDER_STEWARDSHIP align = center|nobaseline alwaystransparent = yes }
                text_single = { parentanchor = center visible = "[ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_holder_sort').GetFlagName, 'intrigue')]" text = SLTM_LVM_SORT_HOLDER_INTRIGUE align = center|nobaseline alwaystransparent = yes }
                text_single = { parentanchor = center visible = "[ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_holder_sort').GetFlagName, 'learning')]" text = SLTM_LVM_SORT_HOLDER_LEARNING align = center|nobaseline alwaystransparent = yes }
                text_single = { parentanchor = center visible = "[ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_holder_sort').GetFlagName, 'prowess')]" text = SLTM_LVM_SORT_HOLDER_PROWESS align = center|nobaseline alwaystransparent = yes }
                text_single = { parentanchor = center visible = "[ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_holder_sort').GetFlagName, 'merit')]" text = SLTM_LVM_SORT_HOLDER_MERIT align = center|nobaseline alwaystransparent = yes }
                text_single = { parentanchor = center visible = "[ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_holder_sort').GetFlagName, 'efficiency')]" text = SLTM_LVM_SORT_HOLDER_EFFICIENCY align = center|nobaseline alwaystransparent = yes }
                text_single = { parentanchor = center visible = "[ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_holder_sort').GetFlagName, 'treasury_balance')]" text = SLTM_LVM_SORT_HOLDER_TREASURY_BALANCE align = center|nobaseline alwaystransparent = yes }
                text_single = { parentanchor = center visible = "[ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_holder_sort').GetFlagName, 'treasury')]" text = SLTM_LVM_SORT_HOLDER_TREASURY align = center|nobaseline alwaystransparent = yes }
                text_single = { parentanchor = center visible = "[ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_holder_sort').GetFlagName, 'strength')]" text = SLTM_LVM_SORT_HOLDER_STRENGTH align = center|nobaseline alwaystransparent = yes }
                text_single = { parentanchor = center visible = "[ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_holder_sort').GetFlagName, 'atwar')]" text = SLTM_LVM_SORT_HOLDER_ATWAR align = center|nobaseline alwaystransparent = yes }
                text_single = { parentanchor = center visible = "[ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_holder_sort').GetFlagName, 'pending')]" text = SLTM_LVM_SORT_HOLDER_PENDING align = center|nobaseline alwaystransparent = yes }
                text_single = { parentanchor = center visible = "[ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_holder_sort').GetFlagName, 'blocked')]" text = SLTM_LVM_SORT_HOLDER_BLOCKED align = center|nobaseline alwaystransparent = yes }
            }

            button_standard = {
                name = "title_sort_direction"
                size = { 25 25 }
                visible = "[GetVariableSystem.HasValue('sltm_lvm_tabs', 'titles')]"
                onclick = "[GetScriptedGui('sltm_lvm_toggle_title_sort_order_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                tooltip = SLTM_LVM_SORT_DIRECTION_TT
                using = tooltip_nw
                button_icon = {
                    alwaystransparent = yes
                    parentanchor = center
                    size = { 25 25 }
                    texture = "gfx/interface/icons/flat_icons/sort_icon.dds"
                    framesize = { 66 66 }
                    frame = "[BoolTo1And2(ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_title_sort_desc').GetFlagName, 'yes'))]"
                    blockoverride "button_frames" { effectname = "NoHighlight" }
                }
            }

            button_standard = {
                name = "holder_sort_direction"
                size = { 25 25 }
                visible = "[Or(GetVariableSystem.HasValue('sltm_lvm_tabs', 'holders'), GetVariableSystem.HasValue('sltm_lvm_tabs', 'treasury'))]"
                onclick = "[GetScriptedGui('sltm_lvm_toggle_holder_sort_order_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                tooltip = SLTM_LVM_SORT_DIRECTION_TT
                using = tooltip_nw
                button_icon = {
                    alwaystransparent = yes
                    parentanchor = center
                    size = { 25 25 }
                    texture = "gfx/interface/icons/flat_icons/sort_icon.dds"
                    framesize = { 66 66 }
                    frame = "[BoolTo1And2(ObjectsEqual(GetPlayer.MakeScope.Var('sltm_lvm_holder_sort_desc').GetFlagName, 'yes'))]"
                    blockoverride "button_frames" { effectname = "NoHighlight" }
                }
            }

            # R10-35A1：国库页复用成熟的封臣筛选/排序工具栏；旧诊断说明不再占位。
            text_single = {
                visible = no
                text = SLTM_LVM_TREASURY_TOOLBAR_NOTE
                using = Font_Size_Small
                default_format = "#low"
                align = left|nobaseline
                autoresize = no
                size = { 520 30 }
            }

            expand = {}

            # 2026-07-18（V3.3-C）已标记头衔（互动“标记头衔”设置的 sltm_designee_title），与刷新同行同高
            hbox = {
                spacing = 2
                visible = "[And(Not(GetVariableSystem.HasValue('sltm_lvm_tabs', 'treasury')), GetPlayer.MakeScope.Var('sltm_designee_title').IsSet)]"
                datacontext = "[GetPlayer.MakeScope.Var('sltm_designee_title').Title]"
                button_standard = {
                    size = { 240 32 }
                    onclick = "[DefaultOnCoatOfArmsClick(Title.GetID)]"
                    onrightclick = "[DefaultOnCoatOfArmsRightClick(Title.GetID)]"
                    tooltipwidget = { using = LandedTitleTooltip }
                    text_single = { size = { 100% 100% } text = SLTM_LVM_MARKED_TITLE_LABEL using = Font_Size_Small default_format = "#clickable" align = center|nobaseline autoresize = no alwaystransparent = yes }
                }
                button_standard = {
                    size = { 32 32 }
                    onclick = "[GetScriptedGui('sltm_lvm_clear_designee_title_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                    tooltip = SLTM_LVM_CLEAR_MARK_TT
                    text_single = { parentanchor = center text = SLTM_LVM_CLEAR_MARK_X using = Font_Size_Medium default_format = "#N" alwaystransparent = yes }
                }
            }
            text_single = {
                visible = "[And(Not(GetVariableSystem.HasValue('sltm_lvm_tabs', 'treasury')), Not(GetPlayer.MakeScope.Var('sltm_designee_title').IsSet))]"
                size = { 200 32 }
                text = SLTM_LVM_NO_MARKED_TITLE
                using = Font_Size_Small
                default_format = "#low"
                align = center|nobaseline
                autoresize = no
            }

            button_standard = {
                size = { 112 32 }
                text = SLTM_LVM_REFRESH
                onclick = "[GetScriptedGui('sltm_lvm_refresh_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
            }
        }

        hbox = {
            layoutpolicy_horizontal = expanding
            size = { 100% 38 }
            spacing = 4

            button_tab = {
                size = { 190 36 }
                layoutpolicy_horizontal = fixed
                text = SLTM_LVM_TAB_TITLES
                onclick = "[GetVariableSystem.Clear('sltm_lvm_treasury_filters_open')]"
                onclick = "[GetVariableSystem.Set('sltm_lvm_tabs', 'titles')]"
                down = "[GetVariableSystem.HasValue('sltm_lvm_tabs', 'titles')]"
                blockoverride "icon_visible" { visible = no }
            }

            button_tab = {
                size = { 190 36 }
                layoutpolicy_horizontal = fixed
                text = SLTM_LVM_TAB_HOLDERS
                onclick = "[GetVariableSystem.Clear('sltm_lvm_treasury_filters_open')]"
                onclick = "[GetVariableSystem.Set('sltm_lvm_tabs', 'holders')]"
                down = "[GetVariableSystem.HasValue('sltm_lvm_tabs', 'holders')]"
                blockoverride "icon_visible" { visible = no }
            }

            button_tab = {
                size = { 190 36 }
                layoutpolicy_horizontal = fixed
                text = SLTM_LVM_TAB_TREASURY
                onclick = "[GetVariableSystem.Clear('sltm_lvm_title_filters_open')]"
                onclick = "[GetVariableSystem.Clear('sltm_lvm_holder_filters_open')]"
                onclick = "[GetVariableSystem.Clear('sltm_lvm_sort_menu_open')]"
                onclick = "[GetVariableSystem.Set('sltm_lvm_tabs', 'treasury')]"
                down = "[GetVariableSystem.HasValue('sltm_lvm_tabs', 'treasury')]"
                blockoverride "icon_visible" { visible = no }
            }

            expand = {}
        }

        # 头衔页
        # R8.5：保留原生 hbox/vbox 高度传递；左右 pane 自身固定宽度，禁止详情内容改变 split 几何。
        hbox = {
            layoutpolicy_horizontal = expanding
            layoutpolicy_vertical = expanding
            spacing = @sltm_lvm_page_gap
            visible = "[GetVariableSystem.HasValue('sltm_lvm_tabs', 'titles')]"

            vbox = {
                size = { @sltm_lvm_page_left_width 100% }
                layoutpolicy_horizontal = fixed
                layoutpolicy_vertical = expanding
                background = { using = Background_Area_Dark alpha = 0.55 }
                spacing = 4

                # 汇总行与列表表头使用同一个固定高度宿主，并采用绝对 y 坐标。
                # 这样不会再受 vbox 的文本基线、按钮最小高度和自动伸缩影响。
                widget = {
                    size = { @sltm_lvm_page_left_width 76 }

                    hbox = {
                        position = { 0 0 }
                        # 从汇总栏再让出2像素给表头，整体宿主高度保持76不变。
                        size = { @sltm_lvm_page_left_width 28 }
                        background = { using = Background_Area_Light alpha = 0.18 }
                        text_single = {
                            size = { 220 28 }
                            text = SLTM_LVM_PANEL_TITLE_LIST
                            using = Font_Size_Medium
                            margin_left = 10
                            align = left|nobaseline
                            autoresize = no
                            elide = right
                        }
                        expand = {}
                        text_single = {
                            size = { 52 28 }
                            text = SLTM_LVM_RESULT_COUNT
                            using = Font_Size_Small
                            align = right|nobaseline
                            autoresize = no
                        }
                        text_single = {
                            size = { 42 28 }
                            text = "[GetPlayer.MakeScope.Var('sltm_lvm_filtered_title_count').GetValue|0]"
                            using = Font_Size_Small
                            default_format = "#high"
                            align = center|nobaseline
                            autoresize = no
                        }
                        text_single = {
                            size = { 12 28 }
                            raw_text = "/"
                            using = Font_Size_Small
                            align = center|nobaseline
                            autoresize = no
                        }
                        text_single = {
                            size = { 52 28 }
                            text = "[GetPlayer.MakeScope.Var('sltm_lvm_title_count').GetValue|0]"
                            using = Font_Size_Small
                            align = center|nobaseline
                            autoresize = no
                            margin_right = 10
                        }
                    }

                    # 表头与 sltm_lvm_title_row 共用同一套五列横排结构：头衔身份、持有者、类型、兵团、状态。
                    # 表头不再使用独立的绝对 x 坐标。
                    hbox = {
                        layoutpolicy_horizontal = fixed
                        position = { 0 36 }
                        size = { @sltm_lvm_page_left_content_width 40 }
                        spacing = 6
                        button_standard_hover = {
                            size = { @sltm_lvm_title_identity_width 100% }
                            onclick = "[GetScriptedGui('sltm_lvm_sort_titles_tier_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                            tooltip = SLTM_LVM_SORT_TITLE_TIER
                            # 头衔文字与数据行纹章共用54宽子单元，中心严格一致。
                            hbox = {
                                layoutpolicy_horizontal = fixed
                                size = { @sltm_lvm_title_identity_width 100% }
                                text_single = {
                                    size = { @sltm_lvm_col_coa 100% }
                                    text = SLTM_LVM_COLUMN_TITLE
                                    using = Font_Size_Medium
                                    default_format = "#clickable"
                                    align = center|nobaseline
                                    autoresize = no
                                    alwaystransparent = yes
                                }
                                expand = {}
                            }
                        }
                        widget = {
                            size = { @sltm_lvm_col_holder 100% }
                            text_single = {
                                size = { 100% 100% }
                                text = SLTM_LVM_COLUMN_HOLDER
                                using = Font_Size_Medium
                                align = left|nobaseline
                                autoresize = no
                                margin_left = 6
                                margin_right = 6
                            }
                        }
                        button_standard_hover = {
                            size = { @sltm_lvm_col_type 100% }
                            onclick = "[GetScriptedGui('sltm_lvm_sort_titles_type_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                            tooltip = SLTM_LVM_SORT_BY_TYPE
                            text_single = {
                                size = { 100% 100% }
                                text = SLTM_LVM_COLUMN_TYPE
                                using = Font_Size_Medium
                                default_format = "#clickable"
                                align = left|nobaseline
                                autoresize = no
                                alwaystransparent = yes
                                margin_left = 6
                                margin_right = 6
                            }
                        }
                        # 2026-07-18（V3.4-B）兵团列头（类型与状态之间）
                        widget = {
                            size = { @sltm_lvm_col_maa 100% }
                            text_single = {
                                size = { 100% 100% }
                                text = SLTM_LVM_COLUMN_MAA
                                using = Font_Size_Medium
                                align = center|nobaseline
                                autoresize = no
                                tooltip = SLTM_LVM_COLUMN_MAA_TT
                            }
                        }
                        button_standard_hover = {
                            size = { @sltm_lvm_col_status 100% }
                            onclick = "[GetScriptedGui('sltm_lvm_sort_titles_status_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                            tooltip = SLTM_LVM_SORT_BY_STATUS
                            text_single = {
                                size = { 100% 100% }
                                text = SLTM_LVM_COLUMN_STATUS
                                using = Font_Size_Medium
                                default_format = "#clickable"
                                align = left|nobaseline
                                autoresize = no
                                alwaystransparent = yes
                                margin_left = 6
                                margin_right = 6
                            }
                        }
                        expand = {}
                    }
                }

                scrollbox = {
                    layoutpolicy_horizontal = expanding
                    layoutpolicy_vertical = expanding
                    scrollbarpolicy_horizontal = always_off
                    # content_width 已经为滚动条预留22宽；取消原版15/20内容边距，
                    # 让表头和 fixedgridbox 从同一 x=0 起点开始。
                    blockoverride "scrollbox_margins" {
                        margin_left = 0
                        margin_right = 0
                        # 首行 button_standard_list 的边框/选中背景需要与表头留出缓冲。
                        # 左右仍为0，以保持表头和列表横向共用起点。
                        margin_top = 8
                        margin_bottom = 0
                    }
                    visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('sltm_lvm_filtered_title_count').GetValue, '(CFixedPoint)0')]"
                    blockoverride "scrollbox_content" {
                        fixedgridbox = {
                            name = "sltm_lvm_title_grid"
                            addcolumn = @sltm_lvm_page_left_content_width
                            addrow = @sltm_lvm_title_row_height
                            datamodel_reuse_widgets = yes
                            datamodel = "[GetPlayer.MakeScope.GetList('sltm_lvm_visible_titles')]"
                            item = { using = sltm_lvm_title_row }
                        }
                    }
                }

                container = {
                    layoutpolicy_horizontal = expanding
                    layoutpolicy_vertical = expanding
                    visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('sltm_lvm_filtered_title_count').GetValue, '(CFixedPoint)0'))]"
                    text_multi = {
                        parentanchor = center
                        size = { 600 100 }
                        align = center
                        text = SLTM_LVM_EMPTY_FILTERED
                        using = Font_Size_Small
                        autoresize = yes
                        max_width = 600
                    }
                }
            }

            vbox = {
                # R8.6：恢复 R7 已实机稳定的右侧“吃剩余空间”模式。
                # 左 pane 固定 1020；右 pane 由父级剩余宽度决定，selected detail 只改变 pane 内部。
                layoutpolicy_horizontal = expanding
                layoutpolicy_vertical = expanding
                background = { using = Background_Area_Dark alpha = 0.55 }
                spacing = 6

                text_single = {
                    size = { 100% 34 }
                    text = SLTM_LVM_TITLE_DETAILS
                    using = Font_Size_Medium
                    align = center
                    background = { using = Background_Area_Light alpha = 0.18 }
                }

                container = {
                    layoutpolicy_horizontal = expanding
                    layoutpolicy_vertical = expanding
                    visible = "[Not(GetPlayer.MakeScope.Var('sltm_lvm_selected_title').IsSet)]"
                    text_multi = {
                        parentanchor = center
                        text = SLTM_LVM_SELECT_TITLE_HINT
                        using = Font_Size_Small
                        autoresize = yes
                        max_width = 320
                        align = center
                    }
                }

                scrollbox = {
                    layoutpolicy_horizontal = expanding
                    layoutpolicy_vertical = expanding
                    visible = "[GetPlayer.MakeScope.Var('sltm_lvm_selected_title').IsSet]"
                    scrollbarpolicy_horizontal = always_off

                    blockoverride "scrollbox_content" {
                        vbox = {
                            layoutpolicy_horizontal = expanding
                            datacontext = "[GetPlayer.MakeScope.Var('sltm_lvm_selected_title').Title]"
                            spacing = 7
                            margin_left = 10
                            margin_right = 10
                            margin_bottom = 10

                            # 头衔身份卡
                            hbox = {
                                layoutpolicy_horizontal = expanding
                                spacing = 8

                                widget = {
                                    size = { 92 100 }
                                    coa_title_medium_crown = {
                                        parentanchor = center
                                        scale = 0.92
                                    }
                                }

                                vbox = {
                                    layoutpolicy_horizontal = expanding
                                    spacing = 2
                                    margin_top = 5

                                    text_multi = {
                                        layoutpolicy_horizontal = expanding
                                        text = "[Title.GetNameNoTierNoTooltip]"
                                        using = Font_Size_Big
                                        default_format = "#high"
                                        autoresize = yes
                                        max_width = 230
                                        align = left
                                        tooltipwidget = { using = LandedTitleTooltip }
                                    }

                                    vbox_title_type_text = {
                                        layoutpolicy_horizontal = expanding
                                    }

                                    text_single = { size = { 100% 22 } visible = "[ObjectsEqual(Title.MakeScope.Var('sltm_lvm_display_type').GetFlagName, 'junfu')]" text = SLTM_LVM_FILTER_TYPE_JUNFU using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                                    text_single = { size = { 100% 22 } visible = "[ObjectsEqual(Title.MakeScope.Var('sltm_lvm_display_type').GetFlagName, 'chaochen')]" text = SLTM_LVM_FILTER_TYPE_CHAOCHEN using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                                    text_single = { size = { 100% 22 } visible = "[ObjectsEqual(Title.MakeScope.Var('sltm_lvm_display_type').GetFlagName, 'noble_family')]" text = SLTM_LVM_FILTER_TYPE_NOBLE using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                                    text_single = { size = { 100% 22 } visible = "[ObjectsEqual(Title.MakeScope.Var('sltm_lvm_display_type').GetFlagName, 'holy_order')]" text = SLTM_LVM_FILTER_TYPE_HOLY_ORDER using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                                    text_single = { size = { 100% 22 } visible = "[ObjectsEqual(Title.MakeScope.Var('sltm_lvm_display_type').GetFlagName, 'mercenary')]" text = SLTM_LVM_FILTER_TYPE_MERCENARY using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                                    text_single = { size = { 100% 22 } visible = "[ObjectsEqual(Title.MakeScope.Var('sltm_lvm_display_type').GetFlagName, 'religious_head')]" text = SLTM_LVM_FILTER_TYPE_RELIGIOUS_HEAD using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                                    text_single = { size = { 100% 22 } visible = "[ObjectsEqual(Title.MakeScope.Var('sltm_lvm_display_type').GetFlagName, 'other')]" text = SLTM_LVM_FILTER_TYPE_OTHER using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }

                                    # 2026-07-18（V3.3-A2）上级头衔（实际上级=持有者领主主头衔）+ 法理上级，移到身份卡图标旁
                                    hbox = {
                                        layoutpolicy_horizontal = expanding
                                        visible = "[And(Title.HasHolder, Title.GetHolder.GetLiege.IsValid)]"
                                        text_single = { size = { 62 22 } text = SLTM_LVM_FIELD_SUPERIOR_TITLE using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                                        button = {
                                            layoutpolicy_horizontal = expanding
                                            onclick = "[DefaultOnCoatOfArmsClick(Title.GetHolder.GetLiege.GetPrimaryTitle.GetID)]"
                                            onrightclick = "[DefaultOnCoatOfArmsRightClick(Title.GetHolder.GetLiege.GetPrimaryTitle.GetID)]"
                                            tooltip = SLTM_LVM_FIELD_SUPERIOR_TITLE_TT
                                            text_single = { autoresize = yes max_width = 400 text = "[Title.GetHolder.GetLiege.GetPrimaryTitle.GetNameNoTierNoTooltip]" using = Font_Size_Small default_format = "#clickable" align = left|nobaseline alwaystransparent = yes }
                                        }
                                    }
                                    hbox = {
                                        layoutpolicy_horizontal = expanding
                                        visible = "[Title.GetDeJureLiege.IsValid]"
                                        text_single = { size = { 62 22 } text = SLTM_LVM_FIELD_DE_JURE using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                                        button = {
                                            layoutpolicy_horizontal = expanding
                                            onclick = "[DefaultOnCoatOfArmsClick(Title.GetDeJureLiege.GetID)]"
                                            onrightclick = "[DefaultOnCoatOfArmsRightClick(Title.GetDeJureLiege.GetID)]"
                                            tooltip = SLTM_LVM_OPEN_DE_JURE_TITLE_TT
                                            text_single = { autoresize = yes max_width = 400 text = "[Title.GetDeJureLiege.GetNameNoTierNoTooltip]" using = Font_Size_Small default_format = "#clickable" align = left|nobaseline alwaystransparent = yes }
                                        }
                                    }
                                }
                            }

                            hbox = {
                                layoutpolicy_horizontal = expanding
                                spacing = 6
                                text_single = { visible = "[Not(Title.HasHolder)]" text = SLTM_LVM_FILTER_CREATION_UNCREATED using = Font_Size_Small default_format = "#N" tooltip = SLTM_LVM_FILTER_CREATION_UNCREATED_TT }
                                text_single = { visible = "[Title.MakeScope.Var('mytm_junfu_handover_blocked').IsSet]" text = SLTM_LVM_STATUS_BLOCKED using = Font_Size_Small default_format = "#N" tooltip = SLTM_LVM_STATUS_BLOCKED_TT }
                                text_single = { visible = "[And(Not(Title.MakeScope.Var('mytm_junfu_handover_blocked').IsSet), Title.MakeScope.Var('mytm_reassign_pending').IsSet)]" text = SLTM_LVM_STATUS_PENDING using = Font_Size_Small default_format = "#P" tooltip = SLTM_LVM_STATUS_PENDING_TT }
                                text_single = { visible = "[And(And(Not(Title.MakeScope.Var('mytm_junfu_handover_blocked').IsSet), Not(Title.MakeScope.Var('mytm_reassign_pending').IsSet)), And(Title.HasHolder, ObjectsEqual(Title.GetHolder.GetPrimaryTitle, Title.Self)))]" text = SLTM_LVM_FILTER_STATUS_PRIMARY using = Font_Size_Small tooltip = SLTM_LVM_STATUS_PRIMARY_TT }
                                text_single = { visible = "[And(And(Not(Title.MakeScope.Var('mytm_junfu_handover_blocked').IsSet), Not(Title.MakeScope.Var('mytm_reassign_pending').IsSet)), And(Title.HasHolder, Not(ObjectsEqual(Title.GetHolder.GetPrimaryTitle, Title.Self))))]" text = SLTM_LVM_FILTER_STATUS_CONCURRENT using = Font_Size_Small tooltip = SLTM_LVM_STATUS_CONCURRENT_TT }
                                expand = {}
                            }

                            hbox = { layoutpolicy_horizontal = expanding spacing = 4 button_standard = { size = { 165 30 } text = sltm_w_edit enabled = "[GetScriptedGui('sltm_workflow_edit_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('sltm_workflow_edit_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" } button_standard = { size = { 165 30 } text = sltm_w_domicile enabled = "[GetScriptedGui('sltm_workflow_domicile_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('sltm_workflow_domicile_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" } expand = {} }
                            # 2026-07-18（V3.3-E）无地头衔管理操作（上移至持有者信息上方）。
                            # V3.6.7 起，“迁移驻地”统一放入下方持有者互动面板，避免同页重复入口。
                            divider = { layoutpolicy_horizontal = expanding }
                            text_single = { layoutpolicy_horizontal = expanding text = SLTM_LVM_SECTION_ACTIONS using = Font_Size_Medium align = left|nobaseline autoresize = no }
                            hbox = {
                                layoutpolicy_horizontal = expanding
                                spacing = 4
                                button_standard = { size = { 165 30 } text = SLTM_LVM_ACT_MARK enabled = "[GetScriptedGui('sltm_lvm_act_mark_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('sltm_lvm_act_mark_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = SLTM_LVM_ACT_MARK_TT }
                                button_standard = { size = { 165 30 } text = SLTM_LVM_ACT_CREATE enabled = "[GetScriptedGui('sltm_lvm_act_create_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('sltm_lvm_act_create_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = SLTM_LVM_ACT_CREATE_TT }
                                expand = {}
                            }
                            hbox = {
                                layoutpolicy_horizontal = expanding
                                spacing = 4
                                button_standard = { size = { 165 30 } text = SLTM_LVM_ACT_GRANT enabled = "[GetScriptedGui('sltm_lvm_act_grant_marked_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('sltm_lvm_act_grant_marked_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = SLTM_LVM_ACT_GRANT_TT }
                                button_standard = { size = { 165 30 } text = SLTM_LVM_ACT_MOVE_CAPITAL enabled = "[GetScriptedGui('sltm_lvm_act_move_capital_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('sltm_lvm_act_move_capital_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = SLTM_LVM_ACT_MOVE_CAPITAL_TT }
                                expand = {}
                            }
                            hbox = {
                                layoutpolicy_horizontal = expanding
                                spacing = 4
                                button_standard = { size = { 165 30 } text = SLTM_LVM_ACT_MOVE_DOMICILE enabled = "[GetScriptedGui('sltm_lvm_act_move_domicile_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('sltm_lvm_act_move_domicile_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = SLTM_LVM_ACT_MOVE_DOMICILE_TT }
                                button_standard = { size = { 165 30 } text = SLTM_LVM_ACT_TRANSFER enabled = "[GetScriptedGui('sltm_lvm_act_transfer_de_jure_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('sltm_lvm_act_transfer_de_jure_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = SLTM_LVM_ACT_TRANSFER_TT }
                                expand = {}
                            }
                            hbox = {
                                layoutpolicy_horizontal = expanding
                                spacing = 4
                                button_standard = { size = { 165 30 } text = "[SelectLocalization(GetPlayer.MakeScope.Var('sltm_lvm_arm_revoke').IsSet, 'SLTM_LVM_ACT_REVOKE_CONFIRM', 'SLTM_LVM_ACT_REVOKE')]" enabled = "[GetScriptedGui('sltm_lvm_act_revoke_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('sltm_lvm_act_revoke_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = SLTM_LVM_ACT_REVOKE_TT }
                                button_standard = { size = { 165 30 } text = "[SelectLocalization(GetPlayer.MakeScope.Var('sltm_lvm_arm_destroy').IsSet, 'SLTM_LVM_ACT_DESTROY_CONFIRM', 'SLTM_LVM_ACT_DESTROY')]" enabled = "[GetScriptedGui('sltm_lvm_act_destroy_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('sltm_lvm_act_destroy_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = SLTM_LVM_ACT_DESTROY_TT }
                                expand = {}
                            }

                            divider = { layoutpolicy_horizontal = expanding }
                            text_single = { layoutpolicy_horizontal = expanding text = SLTM_LVM_SECTION_HOLDER using = Font_Size_Medium align = left|nobaseline autoresize = no }

                            # 持有者人物卡：头像提供原版完整人物悬停卡、地图高亮和右键互动。
                            hbox = {
                                layoutpolicy_horizontal = expanding
                                visible = "[Title.HasHolder]"
                                datacontext = "[Title.GetHolder]"
                                spacing = 8

                                # V3.7.5：头像列与身份摘要行同为 205px；特质已移出该 hbox。
                                # 头像 85×90 本身不缩放；33px 仅用于对齐年龄关系行。
                                widget = {
                                    size = { 85 205 }
                                    portrait_head_small = {
                                        parentanchor = top|left
                                        position = { 0 33 }
                                    }
                                }

                                vbox = {
                                    layoutpolicy_horizontal = expanding
                                    spacing = 3
                                    margin_top = 4

                                    button = {
                                        size = { 230 26 }
                                        onclick = "[DefaultOnCharacterClick(Character.GetID)]"
                                        onrightclick = "[DefaultOnCharacterRightClick(Character.GetID)]"
                                        tooltipwidget = { container_character_tooltip = {} }
                                        text_single = { size = { 100% 100% } text = "[Character.GetNameNoTooltip]" using = Font_Size_Medium default_format = "#clickable" align = left|nobaseline autoresize = no alwaystransparent = yes }
                                    }

                                    text_single = { layoutpolicy_horizontal = expanding raw_text = "[Character.GetAge] · [Character.GetRelationToString( GetPlayer )]" using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                                    # 2026-07-18（V3.3-A2）六维（含勇武）+ 总督效率，单排图标块贴近本体人物页；旧写法注释保留：
                                    # hbox_skills_grid_character_model = {}（本体列表模板，仅五维、无图标）
                                    hbox = {
                                        layoutpolicy_horizontal = expanding
                                        spacing = 1
                                        vbox = { tooltip = diplomacy_concept using = tooltip_ne spacing = -3 icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 1 } text_single = { text = "[Character.GetSkill('diplomacy')]" default_format = "#high" align = center autoresize = yes } }
                                        vbox = { tooltip = martial_concept using = tooltip_ne spacing = -3 icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 2 } text_single = { text = "[Character.GetSkill('martial')]" default_format = "#high" align = center autoresize = yes } }
                                        vbox = { tooltip = stewardship_concept using = tooltip_ne spacing = -3 icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 3 } text_single = { text = "[Character.GetSkill('stewardship')]" default_format = "#high" align = center autoresize = yes } }
                                        vbox = { tooltip = intrigue_concept using = tooltip_ne spacing = -3 icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 4 } text_single = { text = "[Character.GetSkill('intrigue')]" default_format = "#high" align = center autoresize = yes } }
                                        vbox = { tooltip = learning_concept using = tooltip_ne spacing = -3 icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 5 } text_single = { text = "[Character.GetSkill('learning')]" default_format = "#high" align = center autoresize = yes } }
                                        vbox = { tooltip = "[Character.GetProwessBreakdown]" using = tooltip_ne spacing = -3 icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_prowess.dds" } text_single = { text = "[Character.GetProwess|0]" default_format = "#high" align = center autoresize = yes } }
                                        vbox = {
                                            visible = "[Or( Character.GetGovernment.HasRule( 'administrative' ), And( And( Not( Character.HasLandedTitles ), Not( Character.HasLiege ) ), GetPlayer.GetGovernment.HasRule( 'administrative' ) ) )]"
                                            tooltip = "ADMIN_WINDOW_THEME_GOVERNOR_EFFICIENCY_TT"
                                            using = tooltip_ne
                                            spacing = -3
                                            icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_skill_governor_efficiency.dds" }
                                            text_single = { text = "ADMIN_WINDOW_THEME_GOVERNOR_EFFICIENCY_VALUE" align = center autoresize = yes }
                                        }
                                        expand = {}
                                    }
                                    # 贤能品级（有品级者显示，tooltip 用本体贤能明细）
                                    text_single = {
                                        layoutpolicy_horizontal = expanding
                                        visible = "[GreaterThan_int32(Character.GetMeritLevel, '(int32)0')]"
                                        raw_text = "@merit_icon! [GetMeritLevelShortNameNoTooltip(Character.GetMeritLevel)]"
                                        using = Font_Size_Small
                                        tooltip = "[Character.GetMeritTooltipWithBalance]"
                                        align = left|nobaseline
                                        autoresize = no
                                    }
                                    text_single = { layoutpolicy_horizontal = expanding text = "[SelectLocalization( Character.GetGovernment.IsValid(), 'GOVERNMENT_ADJECTIVE_ICON', '' )]" using = Font_Size_Small align = left|nobaseline autoresize = no tooltip = SLTM_LVM_GOVERNMENT_TT }
                                }
                            }

                            # 特质必须位于身份摘要 hbox 之外，否则特质行数会改变 hbox 高度并推动头像下沉。
                            vbox = {
                                layoutpolicy_horizontal = expanding
                                visible = "[Title.HasHolder]"
                                datacontext = "[Title.GetHolder]"
                                margin_left = 93
                                spacing = 3

                                    # 2026-07-18（V3.3-B）持有者全部特质：本体 Character.GetTraitsForCharacter + icon_trait（自带原版特质 tooltip）
                                    text_single = { layoutpolicy_horizontal = expanding text = SLTM_LVM_SECTION_TRAITS using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no margin_top = 4 }
                                    fixedgridbox = {
                                        datamodel = "[Character.GetTraitsForCharacter]"
                                        datamodel_reuse_widgets = yes
                                        flipdirection = yes
                                        addcolumn = 32
                                        addrow = 34
                                        datamodel_wrap = 8
                                        item = {
                                            icon_trait = {
                                                visible = "[Trait.IsValid]"
                                                blockoverride "icon_size" { size = { 30 30 } }
                                                blockoverride "tooltip_placement" { using = tooltip_se }
                                                blockoverride "glow_radius" { glow_radius = 3 }
                                            }
                                        }
                                    }
                                }

                            # V3.6.3：头衔页持有者资源，结构与无地封臣详情资源区一致。
                            vbox = {
                                layoutpolicy_horizontal = expanding
                                visible = "[Title.HasHolder]"
                                datacontext = "[Title.GetHolder]"
                                spacing = 4

                                divider = { layoutpolicy_horizontal = expanding }
                                text_single = { layoutpolicy_horizontal = expanding text = SLTM_LVM_SECTION_RESOURCES using = Font_Size_Medium align = left|nobaseline autoresize = no }
                                hbox = {
                                    layoutpolicy_horizontal = expanding
                                    spacing = 16
                                    margin_left = 4
                                    margin_right = 4

                                    hbox = {
                                        tooltip = "[Character.GetGoldTooltipWithBalance]"
                                        using = tooltip_se
                                        spacing = 3
                                        icon = { size = { 30 30 } texture = "gfx/interface/icons/icon_gold.dds" }
                                        text_single = { text = "[Character.GetGold|0]" default_format = "#high" align = center|nobaseline max_width = 60 }
                                    }
                                    hbox = {
                                        visible = "[Character.HasTreasury]"
                                        tooltip = "[Character.GetTreasuryTooltipWithBalance]"
                                        using = tooltip_se
                                        spacing = 3
                                        icon = { size = { 30 30 } texture = "gfx/interface/icons/icon_imperial_treasury.dds" }
                                        text_single = { text = "[Character.GetTreasury|0]" default_format = "#high" align = center|nobaseline max_width = 60 }
                                    }
                                    expand = {}
                                }

                                # V3.6.7：头衔页与封臣页复用同一持有者互动面板。
                                # 互动按钮使用固定 165×30 双列槽位，显示/隐藏不会改变列坐标。
                                using = sltm_lvm_holder_interaction_panel
                            }

                            text_single = {
                                layoutpolicy_horizontal = expanding
                                visible = "[Not(Title.HasHolder)]"
                                text = SLTM_LVM_NO_VALID_HOLDER
                                using = Font_Size_Small
                                default_format = "#N"
                                align = center
                            }

                            # 2026-07-18（V3.3-F）持有者的“全部头衔”（含有地/无地，来自 selected_title.holder.every_held_title）
                            vbox = {
                                layoutpolicy_horizontal = expanding
                                visible = "[Title.HasHolder]"
                                spacing = 3
                                text_single = { layoutpolicy_horizontal = expanding text = SLTM_LVM_SECTION_HOLDER_ALL_TITLES using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                                fixedgridbox = {
                                    layoutpolicy_horizontal = expanding
                                    visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('sltm_lvm_sel_title_holder_all_count').GetValue, '(CFixedPoint)0')]"
                                    datamodel = "[GetPlayer.MakeScope.GetList('sltm_lvm_sel_title_holder_all_titles')]"
                                    datamodel_reuse_widgets = yes
                                    addcolumn = 340
                                    addrow = 46
                                    item = { using = sltm_lvm_selected_holder_title_item }
                                }
                            }

                            # 法理与继承关系
                            divider = { layoutpolicy_horizontal = expanding }
                            text_single = { layoutpolicy_horizontal = expanding text = SLTM_LVM_SECTION_RELATIONS using = Font_Size_Medium align = left|nobaseline autoresize = no }

                            # 2026-07-18（V3.3-A2）“类型 / 上级头衔 / 法理上级”三项已上移至顶部头衔身份卡（图标旁）。
                            # 原本位于此处的“法理上级”行注释保留备查（新位置见身份卡 vbox）：
                            # hbox = {
                            #     layoutpolicy_horizontal = expanding
                            #     text_single = { size = { 112 28 } text = SLTM_LVM_FIELD_DE_JURE using = Font_Size_Small align = left|nobaseline autoresize = no }
                            #     button = {
                            #         layoutpolicy_horizontal = expanding
                            #         visible = "[Title.GetDeJureLiege.IsValid]"
                            #         onclick = "[DefaultOnCoatOfArmsClick(Title.GetDeJureLiege.GetID)]"
                            #         onrightclick = "[DefaultOnCoatOfArmsRightClick(Title.GetDeJureLiege.GetID)]"
                            #         tooltip = SLTM_LVM_OPEN_DE_JURE_TITLE_TT
                            #         text_single = { size = { 220 28 } text = "[Title.GetDeJureLiege.GetNameWithUnderlyingNoTooltip]" ... }
                            #     }
                            #     text_single = { ... visible = "[Not(Title.GetDeJureLiege.IsValid)]" text = SLTM_LVM_NO_DE_JURE_LIEGE ... }
                            # }

                            hbox = {
                                layoutpolicy_horizontal = expanding
                                visible = "[Title.GetHeir.IsValid]"
                                text_single = { size = { 112 28 } text = SLTM_LVM_FIELD_HEIR using = Font_Size_Small align = left|nobaseline autoresize = no }
                                button = {
                                    layoutpolicy_horizontal = expanding
                                    datacontext = "[Title.GetHeir]"
                                    onclick = "[DefaultOnCharacterClick(Character.GetID)]"
                                    onrightclick = "[DefaultOnCharacterRightClick(Character.GetID)]"
                                    tooltipwidget = { container_character_tooltip = {} }
                                    text_single = { size = { 220 28 } text = "[Character.GetNameNoTooltip]" using = Font_Size_Small default_format = "#clickable" align = left|nobaseline autoresize = no alwaystransparent = yes }
                                }
                            }

                            vbox = {
                                visible = "[Title.HasHolder]"
                                datacontext = "[Title.GetHolder]"
                                layoutpolicy_horizontal = expanding
                                spacing = 3

                                hbox = {
                                    layoutpolicy_horizontal = expanding
                                    text_single = { size = { 112 28 } text = SLTM_LVM_FIELD_PRIMARY_TITLE using = Font_Size_Small align = left|nobaseline autoresize = no }
                                    button = {
                                        layoutpolicy_horizontal = expanding
                                        datacontext = "[Character.GetPrimaryTitle]"
                                        onclick = "[DefaultOnCoatOfArmsClick(Title.GetID)]"
                                        onrightclick = "[DefaultOnCoatOfArmsRightClick(Title.GetID)]"
                                        tooltipwidget = { using = LandedTitleTooltip }
                                        text_single = { size = { 220 28 } text = "[Title.GetNameWithUnderlyingNoTooltip]" using = Font_Size_Small default_format = "#clickable" align = left|nobaseline autoresize = no alwaystransparent = yes }
                                    }
                                }

                                hbox = {
                                    layoutpolicy_horizontal = expanding
                                    visible = "[Character.GetLiege.IsValid]"
                                    text_single = { size = { 112 28 } text = SLTM_LVM_FIELD_LIEGE using = Font_Size_Small align = left|nobaseline autoresize = no }
                                    button = {
                                        layoutpolicy_horizontal = expanding
                                        # 同类型 Character -> Character datacontext 会被 GUI 拒绝；直接读取领主属性。
                                        onclick = "[DefaultOnCharacterClick(Character.GetLiege.GetID)]"
                                        onrightclick = "[DefaultOnCharacterRightClick(Character.GetLiege.GetID)]"
                                        tooltip = SLTM_LVM_OPEN_LIEGE_TT
                                        text_single = { size = { 220 28 } text = "[Character.GetLiege.GetNameNoTooltip]" using = Font_Size_Small default_format = "#clickable" align = left|nobaseline autoresize = no alwaystransparent = yes }
                                    }
                                }

                                hbox = {
                                    layoutpolicy_horizontal = expanding
                                    visible = "[Character.HasDomicile]"
                                    text_single = { size = { 112 28 } text = SLTM_LVM_FIELD_DOMICILE using = Font_Size_Small align = left|nobaseline autoresize = no }
                                    text_single = { layoutpolicy_horizontal = expanding raw_text = "[Character.GetDomicile.GetName]" using = Font_Size_Small align = left|nobaseline autoresize = no }
                                }

                                hbox = {
                                    layoutpolicy_horizontal = expanding
                                    spacing = 8
                                    margin_top = 4

                                    widget = {
                                        size = { 45 45 }
                                        coa_house_small = { datacontext = "[Character.GetHouse]" parentanchor = center scale = 0.7 }
                                    }

                                    icon = {
                                        size = { 38 38 }
                                        datacontext = "[Character.GetFaith]"
                                        texture = "[Faith.GetIcon]"
                                        tooltipwidget = { faith_tooltip = {} }
                                        using = tooltip_se
                                    }

                                    hbox = {
                                        datacontext = "[Character.GetCulture]"
                                        spacing = 3
                                        tooltipwidget = { culture_tooltip = {} }
                                        using = tooltip_se
                                        icon = { texture = "gfx/interface/icons/icon_culture.dds" size = { 26 26 } }
                                        text_single = { text = CULTURE_LISTS_WINDOW using = Font_Size_Small align = left|nobaseline }
                                    }
                                    expand = {}
                                }
                            }

                            # 2026-07-18（V3.3-E）操作区已上移至“持有者信息”上方（头衔信息下方）；此处仅保留“打开原版界面”。
                            divider = { layoutpolicy_horizontal = expanding }
                            button_standard = {
                                size = { 100% 34 }
                                text = SLTM_LVM_OPEN_VANILLA_PAGE
                                onclick = "[DefaultOnCoatOfArmsClick(Title.GetID)]"
                            }
                            text_multi = {
                                layoutpolicy_horizontal = expanding
                                text = SLTM_LVM_ACTIONS_P1_NOTE
                                using = Font_Size_Small
                                default_format = "#low"
                                autoresize = yes
                                max_width = 335
                                align = center
                            }
                        }
                    }
                }
            }
        }

        # 持有者页
        hbox = {
            layoutpolicy_horizontal = expanding
            layoutpolicy_vertical = expanding
            spacing = @sltm_lvm_page_gap
            visible = "[GetVariableSystem.HasValue('sltm_lvm_tabs', 'holders')]"

            vbox = {
                size = { @sltm_lvm_page_left_width 100% }
                layoutpolicy_horizontal = fixed
                layoutpolicy_vertical = expanding
                background = { using = Background_Area_Dark alpha = 0.55 }
                spacing = 4

                # 汇总行与表头共用一个固定高度宿主，结构与头衔页保持一致。
                # 不再让 vbox 根据文本基线和按钮最小高度自动推算表头位置。
                widget = {
                    size = { @sltm_lvm_page_left_width @sltm_lvm_holder_header_host_height }

                    hbox = {
                        position = { 0 0 }
                        size = { @sltm_lvm_page_left_width 28 }
                        background = { using = Background_Area_Light alpha = 0.18 }
                        text_single = {
                            size = { 220 28 }
                            text = SLTM_LVM_PANEL_HOLDER_LIST
                            using = Font_Size_Medium
                            margin_left = 10
                            align = left|nobaseline
                            autoresize = no
                            elide = right
                        }
                        expand = {}
                        text_single = {
                            size = { 52 28 }
                            text = SLTM_LVM_RESULT_COUNT
                            using = Font_Size_Small
                            align = right|nobaseline
                            autoresize = no
                        }
                        text_single = {
                            size = { 42 28 }
                            text = "[GetPlayer.MakeScope.Var('sltm_lvm_filtered_holder_count').GetValue|0]"
                            using = Font_Size_Small
                            default_format = "#high"
                            align = center|nobaseline
                            autoresize = no
                        }
                        text_single = {
                            size = { 12 28 }
                            raw_text = "/"
                            using = Font_Size_Small
                            align = center|nobaseline
                            autoresize = no
                        }
                        text_single = {
                            size = { 52 28 }
                            text = "[GetPlayer.MakeScope.Var('sltm_lvm_holder_count').GetValue|0]"
                            using = Font_Size_Small
                            align = center|nobaseline
                            autoresize = no
                            margin_right = 10
                        }
                    }

                    hbox = {
                        layoutpolicy_horizontal = fixed
                        position = { 0 36 }
                        size = { @sltm_lvm_page_left_content_width 40 }
                        spacing = @sltm_lvm_holder_col_gap

                        # 头像列
                        text_single = { size = { @sltm_lvm_holder_col_portrait 100% } text = "" }

                        # 人物列：按钮占满整列，文字使用与数据行相同的左内边距。
                        button_standard_hover = {
                            size = { @sltm_lvm_holder_col_character 100% }
                            onclick = "[GetScriptedGui('sltm_lvm_sort_holders_rank_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
                            tooltip = SLTM_LVM_SORT_BY_RANK
                            text_single = {
                                size = { 100% 100% }
                                text = SLTM_LVM_COLUMN_CHARACTER
                                using = Font_Size_Medium
                                align = left|nobaseline
                                autoresize = no
                                margin_left = 6
                                alwaystransparent = yes
                            }
                        }

                        # 主头衔列
                        widget = {
                            size = { @sltm_lvm_holder_col_primary 100% }
                            text_single = {
                                size = { 100% 100% }
                                text = SLTM_LVM_COLUMN_PRIMARY_TITLE
                                using = Font_Size_Small
                                align = left|nobaseline
                                autoresize = no
                                margin_left = 6
                                alwaystransparent = yes
                            }
                        }

                        # 2026-07-18：五维、管理总数、待处理、受阻、头衔类型列已移除。
                        widget = {
                            size = { @sltm_lvm_holder_col_merit 100% }
                            text_single = { parentanchor = center size = { 100% 24 } text = SLTM_LVM_COLUMN_MERIT using = Font_Size_Small align = center|nobaseline autoresize = no }
                        }
                        widget = {
                            size = { @sltm_lvm_holder_col_efficiency 100% }
                            text_single = { parentanchor = center size = { 100% 24 } text = SLTM_LVM_COLUMN_EFFICIENCY using = Font_Size_Small align = center|nobaseline autoresize = no tooltip = SLTM_LVM_COLUMN_EFFICIENCY_TT }
                        }
                        widget = {
                            size = { @sltm_lvm_holder_col_treasury 100% }
                            text_single = { parentanchor = center size = { 100% 24 } text = SLTM_LVM_COLUMN_TREASURY using = Font_Size_Small align = center|nobaseline autoresize = no tooltip = SLTM_LVM_COLUMN_TREASURY_TT }
                        }
                        widget = {
                            size = { @sltm_lvm_holder_col_treasury_total 100% }
                            text_single = { parentanchor = center size = { 100% 24 } text = SLTM_LVM_COLUMN_TREASURY_TOTAL using = Font_Size_Small align = center|nobaseline autoresize = no tooltip = SLTM_LVM_COLUMN_TREASURY_TOTAL_TT }
                        }
                        widget = {
                            size = { @sltm_lvm_holder_col_strength 100% }
                            text_single = { parentanchor = center size = { 100% 24 } text = SLTM_LVM_COLUMN_STRENGTH using = Font_Size_Small align = center|nobaseline autoresize = no tooltip = SLTM_LVM_COLUMN_STRENGTH_TT }
                        }
                        widget = {
                            size = { @sltm_lvm_holder_col_atwar 100% }
                            text_single = { parentanchor = center size = { 100% 24 } text = SLTM_LVM_COLUMN_ATWAR using = Font_Size_Small align = center|nobaseline autoresize = no }
                        }
                        # 九列宽度与八个间隔合计998，与统一左侧内容轨道一致，不再使用尾部占位列。
                    }
                }

                scrollbox = {
                    layoutpolicy_horizontal = expanding
                    layoutpolicy_vertical = expanding
                    scrollbarpolicy_horizontal = always_off
                    visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('sltm_lvm_filtered_holder_count').GetValue, '(CFixedPoint)0')]"
                    blockoverride "scrollbox_content" {
                        fixedgridbox = {
                            name = "sltm_lvm_holder_grid"
                            addcolumn = @sltm_lvm_page_left_content_width
                            addrow = @sltm_lvm_holder_row_height
                            datamodel_reuse_widgets = yes
                            datamodel = "[GetPlayer.MakeScope.GetList('sltm_lvm_visible_holders')]"
                            item = { using = sltm_lvm_holder_row }
                        }
                    }
                }

                container = {
                    layoutpolicy_horizontal = expanding
                    layoutpolicy_vertical = expanding
                    visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('sltm_lvm_filtered_holder_count').GetValue, '(CFixedPoint)0'))]"
                    text_multi = {
                        parentanchor = center
                        size = { 600 100 }
                        align = center
                        text = SLTM_LVM_EMPTY_FILTERED
                        using = Font_Size_Small
                        autoresize = yes
                        max_width = 600
                    }
                }
            }

            vbox = {
                # R8.6：恢复 R7 已实机稳定的右侧“吃剩余空间”模式。
                # 左 pane 固定 1020；右 pane 由父级剩余宽度决定，selected detail 只改变 pane 内部。
                layoutpolicy_horizontal = expanding
                layoutpolicy_vertical = expanding
                background = { using = Background_Area_Dark alpha = 0.55 }
                spacing = 6

                text_single = {
                    size = { 100% 34 }
                    text = SLTM_LVM_HOLDER_DETAILS
                    using = Font_Size_Medium
                    align = center
                    background = { using = Background_Area_Light alpha = 0.18 }
                }

                container = {
                    layoutpolicy_horizontal = expanding
                    layoutpolicy_vertical = expanding
                    visible = "[Not(GetPlayer.MakeScope.Var('sltm_lvm_selected_character').IsSet)]"
                    text_multi = {
                        parentanchor = center
                        text = SLTM_LVM_SELECT_HOLDER_HINT
                        using = Font_Size_Small
                        autoresize = yes
                        max_width = 320
                        align = center
                    }
                }

                scrollbox = {
                    layoutpolicy_horizontal = expanding
                    layoutpolicy_vertical = expanding
                    visible = "[GetPlayer.MakeScope.Var('sltm_lvm_selected_character').IsSet]"
                    scrollbarpolicy_horizontal = always_off

                    blockoverride "scrollbox_content" {
                        vbox = {
                            layoutpolicy_horizontal = expanding
                            datacontext = "[GetPlayer.MakeScope.Var('sltm_lvm_selected_character').Char]"
                            spacing = 7
                            margin_left = 10
                            margin_right = 10
                            margin_bottom = 10

                            # V3.6.2：与“无地头衔 → 持有者信息”共用同一视觉结构。
                            # 六维、总督效率、贤能品级、政体与特质集中在人物身份卡内，
                            # 避免旧式技能横条和下方特质区造成信息割裂与重复。
                            hbox = {
                                layoutpolicy_horizontal = expanding
                                spacing = 8

                                # 与头衔页使用同一 205px 身份摘要结构，特质不再参与本 hbox 高度计算。
                                widget = {
                                    size = { 85 205 }
                                    portrait_head_small = {
                                        parentanchor = top|left
                                        position = { 0 33 }
                                    }
                                }

                                vbox = {
                                    layoutpolicy_horizontal = expanding
                                    spacing = 3
                                    margin_top = 4

                                     button = {
                                        size = { 230 26 }
                                        onclick = "[DefaultOnCharacterClick(Character.GetID)]"
                                        onrightclick = "[DefaultOnCharacterRightClick(Character.GetID)]"
                                        tooltipwidget = { container_character_tooltip = {} }
                                        text_single = { size = { 100% 100% } text = "[Character.GetNameNoTooltip]" using = Font_Size_Medium default_format = "#clickable" align = left|nobaseline autoresize = no alwaystransparent = yes }
                                    }

                                    text_single = { layoutpolicy_horizontal = expanding raw_text = "[Character.GetAge] · [Character.GetRelationToString( GetPlayer )]" using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }

                                    # 六维能力与总督效率：图标、数值和 tooltip 均与无地头衔持有者卡一致。
                                    hbox = {
                                        layoutpolicy_horizontal = expanding
                                        spacing = 1
                                        vbox = { tooltip = diplomacy_concept using = tooltip_ne spacing = -3 icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 1 } text_single = { text = "[Character.GetSkill('diplomacy')]" default_format = "#high" align = center autoresize = yes } }
                                        vbox = { tooltip = martial_concept using = tooltip_ne spacing = -3 icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 2 } text_single = { text = "[Character.GetSkill('martial')]" default_format = "#high" align = center autoresize = yes } }
                                        vbox = { tooltip = stewardship_concept using = tooltip_ne spacing = -3 icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 3 } text_single = { text = "[Character.GetSkill('stewardship')]" default_format = "#high" align = center autoresize = yes } }
                                        vbox = { tooltip = intrigue_concept using = tooltip_ne spacing = -3 icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 4 } text_single = { text = "[Character.GetSkill('intrigue')]" default_format = "#high" align = center autoresize = yes } }
                                        vbox = { tooltip = learning_concept using = tooltip_ne spacing = -3 icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 5 } text_single = { text = "[Character.GetSkill('learning')]" default_format = "#high" align = center autoresize = yes } }
                                        vbox = { tooltip = "[Character.GetProwessBreakdown]" using = tooltip_ne spacing = -3 icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_prowess.dds" } text_single = { text = "[Character.GetProwess|0]" default_format = "#high" align = center autoresize = yes } }
                                        vbox = {
                                            visible = "[Or( Character.GetGovernment.HasRule( 'administrative' ), And( And( Not( Character.HasLandedTitles ), Not( Character.HasLiege ) ), GetPlayer.GetGovernment.HasRule( 'administrative' ) ) )]"
                                            tooltip = "ADMIN_WINDOW_THEME_GOVERNOR_EFFICIENCY_TT"
                                            using = tooltip_ne
                                            spacing = -3
                                            icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_skill_governor_efficiency.dds" }
                                            text_single = { text = "ADMIN_WINDOW_THEME_GOVERNOR_EFFICIENCY_VALUE" align = center autoresize = yes }
                                        }
                                        expand = {}
                                    }

                                    text_single = {
                                        layoutpolicy_horizontal = expanding
                                        visible = "[GreaterThan_int32(Character.GetMeritLevel, '(int32)0')]"
                                        raw_text = "@merit_icon! [GetMeritLevelShortNameNoTooltip(Character.GetMeritLevel)]"
                                        using = Font_Size_Small
                                        tooltip = "[Character.GetMeritTooltipWithBalance]"
                                        align = left|nobaseline
                                        autoresize = no
                                    }
                                    text_single = { layoutpolicy_horizontal = expanding text = "[SelectLocalization( Character.GetGovernment.IsValid(), 'GOVERNMENT_ADJECTIVE_ICON', '' )]" using = Font_Size_Small align = left|nobaseline autoresize = no tooltip = SLTM_LVM_GOVERNMENT_TT }
                                }
                            }

                            # 特质移出身份摘要 hbox；保留与右侧信息列一致的 93px 起点。
                            vbox = {
                                layoutpolicy_horizontal = expanding
                                margin_left = 93
                                spacing = 3

                                    text_single = { layoutpolicy_horizontal = expanding text = SLTM_LVM_SECTION_TRAITS using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no margin_top = 4 }
                                    fixedgridbox = {
                                        datamodel = "[Character.GetTraitsForCharacter]"
                                        datamodel_reuse_widgets = yes
                                        flipdirection = yes
                                        addcolumn = 32
                                        addrow = 34
                                        datamodel_wrap = 8
                                        item = {
                                            icon_trait = {
                                                visible = "[Trait.IsValid]"
                                                blockoverride "icon_size" { size = { 30 30 } }
                                                blockoverride "tooltip_placement" { using = tooltip_se }
                                                blockoverride "glow_radius" { glow_radius = 3 }
                                            }
                                        }
                                    }
                                }

                            divider = { layoutpolicy_horizontal = expanding }
                            text_single = { layoutpolicy_horizontal = expanding text = SLTM_LVM_SECTION_REALM using = Font_Size_Medium align = left|nobaseline autoresize = no }

                            hbox = {
                                layoutpolicy_horizontal = expanding
                                text_single = { size = { 112 28 } text = SLTM_LVM_FIELD_PRIMARY_TITLE using = Font_Size_Small align = left|nobaseline autoresize = no }
                                button = {
                                    layoutpolicy_horizontal = expanding
                                    datacontext = "[Character.GetPrimaryTitle]"
                                    onclick = "[DefaultOnCoatOfArmsClick(Title.GetID)]"
                                    onrightclick = "[DefaultOnCoatOfArmsRightClick(Title.GetID)]"
                                    tooltipwidget = { using = LandedTitleTooltip }
                                    text_single = { size = { 220 28 } text = "[Title.GetNameWithUnderlyingNoTooltip]" using = Font_Size_Small default_format = "#clickable" align = left|nobaseline autoresize = no alwaystransparent = yes }
                                }
                            }

                            hbox = {
                                layoutpolicy_horizontal = expanding
                                visible = "[Character.GetLiege.IsValid]"
                                text_single = { size = { 112 28 } text = SLTM_LVM_FIELD_LIEGE using = Font_Size_Small align = left|nobaseline autoresize = no }
                                button = {
                                    layoutpolicy_horizontal = expanding
                                    onclick = "[DefaultOnCharacterClick(Character.GetLiege.GetID)]"
                                    onrightclick = "[DefaultOnCharacterRightClick(Character.GetLiege.GetID)]"
                                    tooltip = SLTM_LVM_OPEN_LIEGE_TT
                                    text_single = { size = { 220 28 } text = "[Character.GetLiege.GetNameNoTooltip]" using = Font_Size_Small default_format = "#clickable" align = left|nobaseline autoresize = no alwaystransparent = yes }
                                }
                            }

                            hbox = {
                                layoutpolicy_horizontal = expanding
                                visible = "[Not(ObjectsEqual(Character.Self, Character.GetTopLiege))]"
                                text_single = { size = { 112 28 } text = SLTM_LVM_FIELD_TOP_LIEGE using = Font_Size_Small align = left|nobaseline autoresize = no }
                                button = {
                                    layoutpolicy_horizontal = expanding
                                    onclick = "[DefaultOnCharacterClick(Character.GetTopLiege.GetID)]"
                                    onrightclick = "[DefaultOnCharacterRightClick(Character.GetTopLiege.GetID)]"
                                    tooltip = SLTM_LVM_OPEN_TOP_LIEGE_TT
                                    text_single = { size = { 220 28 } text = "[Character.GetTopLiege.GetNameNoTooltip]" using = Font_Size_Small default_format = "#clickable" align = left|nobaseline autoresize = no alwaystransparent = yes }
                                }
                            }

                            hbox = {
                                layoutpolicy_horizontal = expanding
                                visible = "[Character.HasDomicile]"
                                text_single = { size = { 112 28 } text = SLTM_LVM_FIELD_DOMICILE using = Font_Size_Small align = left|nobaseline autoresize = no }
                                text_single = { layoutpolicy_horizontal = expanding raw_text = "[Character.GetDomicile.GetName]" using = Font_Size_Small align = left|nobaseline autoresize = no }
                            }

                            hbox = {
                                layoutpolicy_horizontal = expanding
                                spacing = 8
                                margin_top = 4

                                widget = {
                                    size = { 45 45 }
                                    coa_house_small = { datacontext = "[Character.GetHouse]" parentanchor = center scale = 0.7 }
                                }
                                icon = {
                                    size = { 38 38 }
                                    datacontext = "[Character.GetFaith]"
                                    texture = "[Faith.GetIcon]"
                                    tooltipwidget = { faith_tooltip = {} }
                                    using = tooltip_se
                                }
                                hbox = {
                                    datacontext = "[Character.GetCulture]"
                                    spacing = 3
                                    tooltipwidget = { culture_tooltip = {} }
                                    using = tooltip_se
                                    icon = { texture = "gfx/interface/icons/icon_culture.dds" size = { 26 26 } }
                                    text_single = { text = CULTURE_LISTS_WINDOW using = Font_Size_Small align = left|nobaseline }
                                }
                                expand = {}
                            }

                            divider = { layoutpolicy_horizontal = expanding }
                            text_single = { layoutpolicy_horizontal = expanding text = SLTM_LVM_SECTION_RESOURCES using = Font_Size_Medium align = left|nobaseline autoresize = no }

                            hbox = {
                                layoutpolicy_horizontal = expanding
                                spacing = 16
                                margin_left = 4
                                margin_right = 4

                                hbox = {
                                    tooltip = "[Character.GetGoldTooltipWithBalance]"
                                    using = tooltip_se
                                    spacing = 3
                                    icon = { size = { 30 30 } texture = "gfx/interface/icons/icon_gold.dds" }
                                    text_single = { text = "[Character.GetGold|0]" default_format = "#high" align = center|nobaseline max_width = 60 }
                                }

                                hbox = {
                                    visible = "[Character.HasTreasury]"
                                    tooltip = "[Character.GetTreasuryTooltipWithBalance]"
                                    using = tooltip_se
                                    spacing = 3
                                    icon = { size = { 30 30 } texture = "gfx/interface/icons/icon_imperial_treasury.dds" }
                                    text_single = { text = "[Character.GetTreasury|0]" default_format = "#high" align = center|nobaseline max_width = 60 }
                                }
                                expand = {}
                            }

                            # V3.6.7：与“无地头衔 → 持有者信息”完全共用，禁止复制两套宽度。
                            using = sltm_lvm_holder_interaction_panel

                            divider = { layoutpolicy_horizontal = expanding }
                            text_single = { layoutpolicy_horizontal = expanding text = SLTM_LVM_MANAGEMENT_OVERVIEW_LABEL using = Font_Size_Medium align = left|nobaseline autoresize = no }

                            hbox = {
                                layoutpolicy_horizontal = expanding
                                text_single = { size = { 112 28 } text = SLTM_LVM_COUNT_MATCHING using = Font_Size_Small align = left|nobaseline autoresize = no }
                                text_single = { layoutpolicy_horizontal = expanding text = "[Character.MakeScope.Var('sltm_lvm_total_managed_title_count').GetValue|0]" using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no }
                            }
                            hbox = {
                                layoutpolicy_horizontal = expanding
                                text_single = { size = { 112 28 } text = SLTM_LVM_COUNT_TOTAL using = Font_Size_Small align = left|nobaseline autoresize = no }
                                text_single = { layoutpolicy_horizontal = expanding text = "[Character.MakeScope.Var('sltm_lvm_total_managed_title_count').GetValue|0]" using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no }
                            }
                            hbox = {
                                layoutpolicy_horizontal = expanding
                                text_single = { size = { 112 28 } text = SLTM_LVM_STATUS_PENDING using = Font_Size_Small align = left|nobaseline autoresize = no tooltip = SLTM_LVM_STATUS_PENDING_TT }
                                text_single = { layoutpolicy_horizontal = expanding text = "[Character.MakeScope.Var('sltm_lvm_pending_title_count').GetValue|0]" using = Font_Size_Small default_format = "#P" align = left|nobaseline autoresize = no }
                            }
                            hbox = {
                                layoutpolicy_horizontal = expanding
                                text_single = { size = { 112 28 } text = SLTM_LVM_STATUS_BLOCKED using = Font_Size_Small align = left|nobaseline autoresize = no tooltip = SLTM_LVM_STATUS_BLOCKED_TT }
                                text_single = { layoutpolicy_horizontal = expanding text = "[Character.MakeScope.Var('sltm_lvm_blocked_title_count').GetValue|0]" using = Font_Size_Small default_format = "#N" align = left|nobaseline autoresize = no }
                            }

                            divider = { layoutpolicy_horizontal = expanding }
                            hbox = {
                                layoutpolicy_horizontal = expanding
                                text_single = { layoutpolicy_horizontal = expanding text = SLTM_LVM_SECTION_TITLES using = Font_Size_Medium align = left|nobaseline autoresize = no }
                                text_single = { size = { 55 28 } text = "[GetPlayer.MakeScope.Var('sltm_lvm_selected_holder_title_count').GetValue|0]" using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no tooltip = SLTM_LVM_SELECTED_HOLDER_TITLE_COUNT_TT }
                            }
                            text_multi = {
                                layoutpolicy_horizontal = expanding
                                visible = "[Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('sltm_lvm_selected_holder_title_count').GetValue, '(CFixedPoint)0'))]"
                                text = SLTM_LVM_EMPTY_SELECTED_HOLDER_TITLES
                                using = Font_Size_Small
                                default_format = "#low"
                                autoresize = yes
                                max_width = 335
                                align = center
                            }
                            fixedgridbox = {
                                visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.Var('sltm_lvm_selected_holder_title_count').GetValue, '(CFixedPoint)0')]"
                                datamodel = "[GetPlayer.MakeScope.GetList('sltm_lvm_selected_holder_titles')]"
                                datamodel_reuse_widgets = yes
                                addcolumn = 340
                                addrow = 46
                                item = { using = sltm_lvm_selected_holder_title_item }
                            }

                            button_standard = {
                                size = { 100% 34 }
                                text = SLTM_LVM_OPEN_VANILLA_PAGE
                                onclick = "[DefaultOnCharacterClick(Character.GetID)]"
                            }
                        }
                    }
                }
            }
        }

        # R10-35A1：A0-BRIDGE 已由用户实机通过（277 / 277）。
        # R10-35A2-1F1：只改展示，不改数据生命周期。
        # 第三页继续直接读取已由用户实机证明 277 / 277 的 sltm_lvm_visible_holders。
        hbox = {
            layoutpolicy_horizontal = expanding
            layoutpolicy_vertical = expanding
            spacing = @sltm_lvm_page_gap
            visible = "[GetVariableSystem.HasValue('sltm_lvm_tabs', 'treasury')]"

            vbox = {
                size = { @sltm_lvm_page_left_width 100% }
                layoutpolicy_horizontal = fixed
                layoutpolicy_vertical = expanding
                background = { using = Background_Area_Dark alpha = 0.55 }
                spacing = 4

                widget = {
                    size = { @sltm_lvm_page_left_width @sltm_lvm_holder_header_host_height }
                    hbox = {
                        position = { 0 0 } size = { @sltm_lvm_page_left_width 28 }
                        background = { using = Background_Area_Light alpha = 0.18 }
                        text_single = { size = { 260 28 } text = SLTM_LVM_TREASURY_VASSAL_LIST using = Font_Size_Medium margin_left = 10 align = left|nobaseline autoresize = no }
                        expand = {}
                        text_single = { size = { 52 28 } text = SLTM_LVM_RESULT_COUNT using = Font_Size_Small align = right|nobaseline autoresize = no }
                        text_single = { size = { 42 28 } text = "[GetPlayer.MakeScope.Var('sltm_lvm_filtered_holder_count').GetValue|0]" using = Font_Size_Small default_format = "#high" align = center|nobaseline autoresize = no }
                        text_single = { size = { 12 28 } raw_text = "/" using = Font_Size_Small align = center|nobaseline autoresize = no }
                        text_single = { size = { 52 28 } text = "[GetPlayer.MakeScope.Var('sltm_lvm_holder_count').GetValue|0]" using = Font_Size_Small align = center|nobaseline autoresize = no margin_right = 8 }
                    }
                    hbox = {
                        layoutpolicy_horizontal = fixed position = { 0 36 } size = { @sltm_lvm_page_left_content_width 40 } spacing = @sltm_lvm_treasury_col_gap
                        widget = { size = { @sltm_lvm_treasury_col_identity 100% } text_single = { size = { 100% 100% } text = SLTM_LVM_TREASURY_COLUMN_VASSAL using = Font_Size_Small align = left|nobaseline autoresize = no margin_left = 10 } }
                        widget = { size = { @sltm_lvm_treasury_col_holder 100% } text_single = { size = { 100% 100% } text = SLTM_LVM_TREASURY_COLUMN_PRIMARY using = Font_Size_Small align = left|nobaseline autoresize = no margin_left = 6 } }
                        widget = { size = { @sltm_lvm_treasury_col_private 100% } text_single = { parentanchor = center size = { 100% 24 } text = SLTM_LVM_TREASURY_COLUMN_PRIVATE using = Font_Size_Small align = center|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_PRIVATE_TT } }
                        widget = { size = { @sltm_lvm_treasury_col_treasury 100% } text_single = { parentanchor = center size = { 100% 24 } text = SLTM_LVM_TREASURY_COLUMN_TREASURY using = Font_Size_Small align = center|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_TREASURY_TT } }
                        widget = { size = { @sltm_lvm_treasury_col_budget 100% } text_single = { parentanchor = center size = { 100% 24 } text = SLTM_LVM_TREASURY_COLUMN_BUDGET_RECEIPT using = Font_Size_Small align = center|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_BUDGET_RECEIPT_TT } }
                        widget = { size = { @sltm_lvm_treasury_col_fixed_grant 100% } text_single = { parentanchor = center size = { 100% 24 } text = SLTM_LVM_TREASURY_COLUMN_FIXED_GRANT using = Font_Size_Small align = center|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_FIXED_GRANT_TT } }
                    }
                }

                scrollbox = {
                    layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding scrollbarpolicy_horizontal = always_off
                    visible = "[DataModelHasItems(GetPlayer.MakeScope.GetList('sltm_lvm_visible_holders'))]"
                    blockoverride "scrollbox_content" {
                        fixedgridbox = {
                            name = "sltm_lvm_treasury_grid" addcolumn = @sltm_lvm_page_left_content_width addrow = @sltm_lvm_treasury_row_height
                            datamodel_reuse_widgets = yes
                            # R10-35A2-1F1：直接使用已实机通过的 sltm_lvm_visible_holders，不派生新列表。
                            datamodel = "[GetPlayer.MakeScope.GetList('sltm_lvm_visible_holders')]"
                            item = { using = sltm_lvm_treasury_row }
                        }
                    }
                }
                container = {
                    layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
                    visible = "[Not(DataModelHasItems(GetPlayer.MakeScope.GetList('sltm_lvm_visible_holders')))]"
                    text_multi = { parentanchor = center size = { 600 100 } align = center text = SLTM_LVM_TREASURY_EMPTY using = Font_Size_Small autoresize = yes max_width = 600 }
                }

                # R8.9：三行紧凑后仅保留 4px 底部安全区，避免滚动框贴住底框。
                widget = { size = { @sltm_lvm_page_left_content_width 4 } layoutpolicy_horizontal = fixed }

                # R10-35A1：筛选/排序已恢复；独立国库分页仍保持关闭，避免同时重启未验收管线。
                hbox = {
                    visible = no
                    size = { @sltm_lvm_page_left_content_width 34 } layoutpolicy_horizontal = fixed spacing = 5
                    expand = {}
                    button_standard_small = { size = { 42 28 } raw_text = "<<" enabled = "[GetScriptedGui('sltm_lvm_treasury_can_prev_page_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('sltm_lvm_treasury_first_page_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = SLTM_LVM_TREASURY_FIRST_PAGE_TT }
                    button_standard_small = { size = { 42 28 } raw_text = "<" enabled = "[GetScriptedGui('sltm_lvm_treasury_can_prev_page_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('sltm_lvm_treasury_prev_page_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = SLTM_LVM_TREASURY_PREV_PAGE_TT }
                    text_single = { size = { 110 28 } text = SLTM_LVM_TREASURY_PAGE_LABEL using = Font_Size_Small align = center|nobaseline autoresize = no }
                    text_single = { size = { 36 28 } text = "[GetPlayer.MakeScope.Var('sltm_lvm_treasury_page').GetValue|0]" using = Font_Size_Small default_format = "#high" align = center|nobaseline autoresize = no }
                    text_single = { size = { 14 28 } raw_text = "/" using = Font_Size_Small align = center|nobaseline autoresize = no }
                    text_single = { size = { 36 28 } text = "[GetPlayer.MakeScope.Var('sltm_lvm_treasury_page_count').GetValue|0]" using = Font_Size_Small align = center|nobaseline autoresize = no }
                    button_standard_small = { size = { 42 28 } raw_text = ">" enabled = "[GetScriptedGui('sltm_lvm_treasury_can_next_page_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('sltm_lvm_treasury_next_page_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = SLTM_LVM_TREASURY_NEXT_PAGE_TT }
                    button_standard_small = { size = { 42 28 } raw_text = ">>" enabled = "[GetScriptedGui('sltm_lvm_treasury_can_next_page_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" onclick = "[GetScriptedGui('sltm_lvm_treasury_last_page_gui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" tooltip = SLTM_LVM_TREASURY_LAST_PAGE_TT }
                    expand = {}
                }
            }

            vbox = {
                # R8.6：与另外两页一致，右 pane 恢复 R7 的 expanding remainder 模式。
                layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding background = { using = Background_Area_Dark alpha = 0.55 } spacing = 6
                text_single = { size = { 100% 34 } text = SLTM_LVM_TREASURY_DETAILS using = Font_Size_Medium align = center background = { using = Background_Area_Light alpha = 0.18 } }

                container = {
                    layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
                    visible = "[Not(GetPlayer.MakeScope.Var('sltm_lvm_treasury_selected_character').IsSet)]"
                    text_multi = { parentanchor = center text = SLTM_LVM_TREASURY_SELECT_HINT using = Font_Size_Small autoresize = yes max_width = 320 align = center }
                }
                scrollbox = {
                    layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
                    visible = "[GetPlayer.MakeScope.Var('sltm_lvm_treasury_selected_character').IsSet]" scrollbarpolicy_horizontal = always_off
                    blockoverride "scrollbox_content" {
                        vbox = {
                            datacontext = "[GetPlayer.MakeScope.Var('sltm_lvm_treasury_selected_character').Char]"
                            # A2-3F2：只修 scrollbox 内部内容 owner。外层左右 pane 与 shared hbox 完全冻结。
                            layoutpolicy_horizontal = expanding
                            spacing = 5 margin_left = 8 margin_right = 8 margin_top = 5
                            # R10-35A2-4B3-RIGHTBOX-R5：人物摘要参照“无地头衔 / 无地封臣”两个分页的成熟人物卡。
                            # 只复用已存在的 Character getter / tooltip，不增加新的计算链；固定 330px 轨道避免实机漂移。
                            vbox = {
                                size = { 330 181 }
                                spacing = 3

                                # 第一层：头像 + 姓名 / 身份 / 年龄关系 / 主头衔。
                                hbox = {
                                    size = { 330 76 }
                                    spacing = 8

                                    widget = {
                                        size = { 64 76 }
                                        portrait_head_small = { parentanchor = top|left position = { 4 6 } scale = 0.82 }
                                        button = {
                                            parentanchor = top|left
                                            position = { 4 6 }
                                            size = { 54 54 }
                                            onclick = "[DefaultOnCharacterClick(Character.GetID)]"
                                            onrightclick = "[DefaultOnCharacterRightClick(Character.GetID)]"
                                            tooltipwidget = { container_character_tooltip = {} }
                                        }
                                    }

                                    vbox = {
                                        size = { 258 76 }
                                        spacing = 1
                                        margin_top = 2

                                        hbox = {
                                            size = { 258 25 }
                                            spacing = 6
                                            text_single = { size = { 170 25 } text = "[Character.GetNameNoTooltip]" using = Font_Size_Medium default_format = "#high" align = left|nobaseline autoresize = no elide = right }
                                            text_single = { visible = "[GetScriptedGui('sltm_lvm_treasury_is_junfu_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]" size = { 82 25 } text = SLTM_LVM_TREASURY_TYPE_JUNFU using = Font_Size_Small default_format = "#P" align = right|nobaseline autoresize = no }
                                            text_single = { visible = "[And(Not(GetScriptedGui('sltm_lvm_treasury_is_junfu_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)), GetScriptedGui('sltm_lvm_treasury_is_military_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End))]" size = { 82 25 } text = SLTM_LVM_TREASURY_TYPE_MILITARY using = Font_Size_Small default_format = "#high" align = right|nobaseline autoresize = no }
                                            text_single = { visible = "[And(Not(GetScriptedGui('sltm_lvm_treasury_is_junfu_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)), Not(GetScriptedGui('sltm_lvm_treasury_is_military_gui').IsShown(GuiScope.SetRoot(Character.MakeScope).End)))]" size = { 82 25 } text = SLTM_LVM_TREASURY_TYPE_OTHER using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                                        }

                                        text_single = { size = { 258 20 } raw_text = "[Character.GetAge] · [Character.GetRelationToString( GetPlayer )]" using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no elide = right }

                                        button = {
                                            size = { 258 24 }
                                            datacontext = "[Character.GetPrimaryTitle]"
                                            onclick = "[DefaultOnCoatOfArmsClick(Title.GetID)]"
                                            onrightclick = "[DefaultOnCoatOfArmsRightClick(Title.GetID)]"
                                            tooltipwidget = { using = LandedTitleTooltip }
                                            text_single = { size = { 258 24 } text = "[Title.GetNameWithUnderlyingNoTooltip]" using = Font_Size_Small default_format = "#clickable" align = left|nobaseline autoresize = no alwaystransparent = yes elide = right }
                                        }
                                    }
                                }

                                # 第二层：直接复用另两个分页的人物六维、勇武、总督效率图标与原版 tooltip。
                                hbox = {
                                    size = { 330 45 }
                                    spacing = 1
                                    margin_left = 3
                                    vbox = { size = { 43 45 } tooltip = diplomacy_concept using = tooltip_ne spacing = -3 icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 1 } text_single = { size = { 43 17 } text = "[Character.GetSkill('diplomacy')]" default_format = "#high" align = center|nobaseline autoresize = no } }
                                    vbox = { size = { 43 45 } tooltip = martial_concept using = tooltip_ne spacing = -3 icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 2 } text_single = { size = { 43 17 } text = "[Character.GetSkill('martial')]" default_format = "#high" align = center|nobaseline autoresize = no } }
                                    vbox = { size = { 43 45 } tooltip = stewardship_concept using = tooltip_ne spacing = -3 icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 3 } text_single = { size = { 43 17 } text = "[Character.GetSkill('stewardship')]" default_format = "#high" align = center|nobaseline autoresize = no } }
                                    vbox = { size = { 43 45 } tooltip = intrigue_concept using = tooltip_ne spacing = -3 icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 4 } text_single = { size = { 43 17 } text = "[Character.GetSkill('intrigue')]" default_format = "#high" align = center|nobaseline autoresize = no } }
                                    vbox = { size = { 43 45 } tooltip = learning_concept using = tooltip_ne spacing = -3 icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_skills.dds" framesize = { 60 60 } frame = 5 } text_single = { size = { 43 17 } text = "[Character.GetSkill('learning')]" default_format = "#high" align = center|nobaseline autoresize = no } }
                                    vbox = { size = { 43 45 } tooltip = "[Character.GetProwessBreakdown]" using = tooltip_ne spacing = -3 icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_prowess.dds" } text_single = { size = { 43 17 } text = "[Character.GetProwess|0]" default_format = "#high" align = center|nobaseline autoresize = no } }
                                    vbox = {
                                        size = { 43 45 }
                                        visible = "[Or( Character.GetGovernment.HasRule( 'administrative' ), And( And( Not( Character.HasLandedTitles ), Not( Character.HasLiege ) ), GetPlayer.GetGovernment.HasRule( 'administrative' ) ) )]"
                                        tooltip = "ADMIN_WINDOW_THEME_GOVERNOR_EFFICIENCY_TT"
                                        using = tooltip_ne
                                        spacing = -3
                                        icon = { size = { 26 26 } texture = "gfx/interface/icons/icon_skill_governor_efficiency.dds" }
                                        text_single = { size = { 43 17 } text = "ADMIN_WINDOW_THEME_GOVERNOR_EFFICIENCY_VALUE" align = center|nobaseline autoresize = no }
                                    }
                                    expand = {}
                                }

                                # 第三层：贤能品级、政体、总兵力和参战角色；全部来自封臣分页已有显示接口。
                                hbox = {
                                    size = { 330 26 }
                                    spacing = 4
                                    text_single = { size = { 78 26 } visible = "[GreaterThan_int32(Character.GetMeritLevel, '(int32)0')]" raw_text = "@merit_icon! [GetMeritLevelShortNameNoTooltip(Character.GetMeritLevel)]" using = Font_Size_Small default_format = "#high" tooltip = "[Character.GetMeritTooltipWithBalance]" align = left|nobaseline autoresize = no elide = right }
                                    text_single = { size = { 104 26 } text = "[SelectLocalization( Character.GetGovernment.IsValid(), 'GOVERNMENT_ADJECTIVE_ICON', '' )]" using = Font_Size_Small align = left|nobaseline autoresize = no tooltip = SLTM_LVM_GOVERNMENT_TT elide = right }
                                    text_single = { size = { 70 26 } text = "[Character.GetMilitaryStrengthText]" using = Font_Size_Small default_format = "#high" align = center|nobaseline autoresize = no tooltip = SLTM_LVM_COLUMN_STRENGTH_TT elide = right }
                                    text_single = { size = { 66 26 } text = "[Character.Custom('sltm_lvm_war_role_text')]" using = Font_Size_Small align = right|nobaseline autoresize = no tooltip = SLTM_LVM_COLUMN_ATWAR_ROLE_TT elide = right }
                                }

                                # 第四层：家族 / 信仰 / 文化完全复用另两个分页已存在的图标与 tooltip，不引入新 getter。
                                hbox = {
                                    size = { 330 25 }
                                    spacing = 8
                                    margin_left = 4
                                    widget = { size = { 30 25 } coa_house_small = { datacontext = "[Character.GetHouse]" parentanchor = center scale = 0.45 } }
                                    icon = { size = { 24 24 } datacontext = "[Character.GetFaith]" texture = "[Faith.GetIcon]" tooltipwidget = { faith_tooltip = {} } using = tooltip_se }
                                    hbox = { size = { 126 25 } datacontext = "[Character.GetCulture]" spacing = 3 tooltipwidget = { culture_tooltip = {} } using = tooltip_se icon = { size = { 22 22 } texture = "gfx/interface/icons/icon_culture.dds" } text_single = { size = { 98 25 } text = CULTURE_LISTS_WINDOW using = Font_Size_Small align = left|nobaseline autoresize = no } }
                                    expand = {}
                                }
                            }

                            divider = { size = { 330 2 } }
                            hbox = {
                                size = { 330 28 }
                                text_single = { size = { 250 28 } text = SLTM_LVM_TREASURY_SECTION_MAA_REFERENCE using = Font_Size_Medium align = left|nobaseline autoresize = no }
                                expand = {}
                                button_standard_small = {
                                    size = { 72 26 }
                                    text = SLTM_LVM_TREASURY_REFRESH_SHORT
                                    onclick = "[GetScriptedGui('sltm_lvm_treasury_refresh_maa_expense_probe_gui').Execute(GuiScope.SetRoot(Character.MakeScope).AddScope('player', GetPlayer.MakeScope).End)]"
                                    tooltip = SLTM_LVM_TREASURY_REFRESH_TT
                                }
                            }

                            hbox = {
                                size = { 330 455 }
                                vbox = {
                                    # 两个 158px 列表均可完整容纳 3×52px 的兵团行，并保留 2px 余量。
                                    size = { 330 455 }
                                    spacing = 7

                                    hbox = {
                                        size = { 330 26 }
                                        text_single = { size = { 250 26 } text = SLTM_LVM_TREASURY_MAA_PERSONAL_HEADER using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no }
                                        text_single = { size = { 55 26 } text = "[GetPlayer.MakeScope.Var('sltm_lvm_treasury_personal_maa_probe_count').GetValue|0]" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                                        text_single = { size = { 25 26 } text = SLTM_LVM_TREASURY_REGIMENT_COUNT_SUFFIX using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                                    }
                                    hbox = {
                                        size = { 330 26 }
                                        hbox = { size = { 82 26 } text_single = { size = { 18 26 } text = SLTM_LVM_TREASURY_SHORT_MIN using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_MIN_GOLD_TT } text_single = { size = { 64 26 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_gold_ai_maa_min_budget_value')|1]" using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_MIN_GOLD_TT } }
                                        hbox = { size = { 82 26 } text_single = { size = { 18 26 } text = SLTM_LVM_TREASURY_SHORT_NORMAL using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_NORMAL_GOLD_TT } text_single = { size = { 64 26 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_actual_gold_maa_expense_value')|2]" using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_NORMAL_GOLD_TT } }
                                        hbox = { size = { 83 26 } text_single = { size = { 18 26 } text = SLTM_LVM_TREASURY_SHORT_TARGET using = Font_Size_Small default_format = "#P" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_TARGET_GOLD_TT } text_single = { size = { 65 26 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_gold_ai_maa_ideal_budget_value')|1]" using = Font_Size_Small default_format = "#P" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_TARGET_GOLD_TT } }
                                        hbox = { size = { 83 26 } text_single = { size = { 18 26 } text = SLTM_LVM_TREASURY_SHORT_MAX using = Font_Size_Small default_format = "#N" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_MAX_GOLD_TT } text_single = { size = { 65 26 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_gold_ai_maa_max_budget_value')|1]" using = Font_Size_Small default_format = "#N" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_MAX_GOLD_TT } }
                                    }
                                    widget = {
                                        size = { 330 158 }
                                        background = { using = Background_Area_Dark alpha = 0.18 }
                                        scrollbox = {
                                            size = { 330 158 }
                                            scrollbarpolicy_horizontal = always_off
                                            visible = "[DataModelHasItems(GetPlayer.MakeScope.GetList('sltm_lvm_treasury_personal_maa_probe_list'))]"
                                            blockoverride "scrollbox_content" {
                                                fixedgridbox = {
                                                    addcolumn = 314 addrow = 52 datamodel_reuse_widgets = yes
                                                    datamodel = "[GetPlayer.MakeScope.GetList('sltm_lvm_treasury_personal_maa_probe_list')]"
                                                    item = { using = sltm_lvm_treasury_maa_probe_regiment_row }
                                                }
                                            }
                                        }
                                        text_single = { visible = "[Not(DataModelHasItems(GetPlayer.MakeScope.GetList('sltm_lvm_treasury_personal_maa_probe_list')))]" parentanchor = center text = SLTM_LVM_TREASURY_MAA_NO_PERSONAL using = Font_Size_Small default_format = "#low" align = center|nobaseline autoresize = yes }
                                    }

                                    hbox = {
                                        size = { 330 26 }
                                        text_single = { size = { 250 26 } text = SLTM_LVM_TREASURY_MAA_TITLE_HEADER using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no }
                                        text_single = { size = { 55 26 } text = "[GetPlayer.MakeScope.Var('sltm_lvm_treasury_title_maa_probe_count').GetValue|0]" using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
                                        text_single = { size = { 25 26 } text = SLTM_LVM_TREASURY_REGIMENT_COUNT_SUFFIX using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                                    }
                                    hbox = {
                                        size = { 330 26 }
                                        hbox = { size = { 82 26 } text_single = { size = { 18 26 } text = SLTM_LVM_TREASURY_SHORT_MIN using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_MIN_TREASURY_TT } text_single = { size = { 64 26 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_ai_maa_min_budget_value')|1]" using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_MIN_TREASURY_TT } }
                                        hbox = { size = { 82 26 } text_single = { size = { 18 26 } text = SLTM_LVM_TREASURY_SHORT_NORMAL using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_NORMAL_TREASURY_TT } text_single = { size = { 64 26 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_actual_treasury_maa_expense_value')|2]" using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_NORMAL_TREASURY_TT } }
                                        hbox = { size = { 83 26 } text_single = { size = { 18 26 } text = SLTM_LVM_TREASURY_SHORT_TARGET using = Font_Size_Small default_format = "#P" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_TARGET_TREASURY_TT } text_single = { size = { 65 26 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_ai_maa_ideal_budget_value')|1]" using = Font_Size_Small default_format = "#P" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_TARGET_TREASURY_TT } }
                                        hbox = { size = { 83 26 } text_single = { size = { 18 26 } text = SLTM_LVM_TREASURY_SHORT_MAX using = Font_Size_Small default_format = "#N" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_MAX_TREASURY_TT } text_single = { size = { 65 26 } text = "[Character.MakeScope().ScriptValue('sltm_lvm_treasury_ai_maa_max_budget_value')|1]" using = Font_Size_Small default_format = "#N" align = left|nobaseline autoresize = no tooltip = SLTM_LVM_TREASURY_SHORT_MAX_TREASURY_TT } }
                                    }
                                    widget = {
                                        size = { 330 158 }
                                        background = { using = Background_Area_Dark alpha = 0.18 }
                                        scrollbox = {
                                            size = { 330 158 }
                                            scrollbarpolicy_horizontal = always_off
                                            visible = "[DataModelHasItems(GetPlayer.MakeScope.GetList('sltm_lvm_treasury_title_maa_probe_list'))]"
                                            blockoverride "scrollbox_content" {
                                                fixedgridbox = {
                                                    addcolumn = 314 addrow = 52 datamodel_reuse_widgets = yes
                                                    datamodel = "[GetPlayer.MakeScope.GetList('sltm_lvm_treasury_title_maa_probe_list')]"
                                                    item = { using = sltm_lvm_treasury_maa_probe_regiment_row }
                                                }
                                            }
