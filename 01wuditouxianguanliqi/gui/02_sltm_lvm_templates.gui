############################################################
# 无地头衔管理器：V2 主窗口
# 结构：工具栏 / 页签 / 宽列表 / 右侧检查器 / 计数栏
############################################################

# R8.6：三分页统一使用同一套有效内容框；左 pane 固定 1020，右 pane 恢复 R7 的 expanding remainder。
# 外窗 1540；Window_Margins 左/右各 40，因此正文有效宽度 = 1540 - 40 - 40 = 1460。
# 预期分框：左框 1020 + 间隔 10 + 右侧剩余 430 = 1460；430 是审计期望值，不再作为右 pane 的 fixed policy。
# 重要：分页根继续由父级正常 flow 放置；R8.6 不再让右 pane 与左 pane 形成双 fixed 竞争。
# 998 = 左框 1020 - 22px 垂直滚动条预留；选中/未选中只改变右框内部内容，不改变左右 pane 宽度。
@sltm_lvm_page_inner_width = 1460
@sltm_lvm_page_left_width = 1020
@sltm_lvm_page_left_content_width = 998
@sltm_lvm_page_right_width = 430
@sltm_lvm_page_gap = 10
@sltm_lvm_title_row_height = 80
@sltm_lvm_holder_row_height = 82
@sltm_lvm_holder_header_host_height = 76

# 无地头衔页：五列总宽 974 + 4×6 间隔 = 998。
@sltm_lvm_col_coa = 54
@sltm_lvm_col_title = 260
@sltm_lvm_col_holder = 230
@sltm_lvm_col_type = 150
@sltm_lvm_col_maa = 90
@sltm_lvm_col_status = 184
# 头衔身份区 = 纹章54 + 内间隔6 + 名称260 = 320。
@sltm_lvm_title_identity_width = 320

# 无地封臣页：九列总宽 966 + 8×4 间隔 = 998。表头与数据行只能引用本组常量。
@sltm_lvm_holder_col_portrait  = 64
@sltm_lvm_holder_col_character  = 230
@sltm_lvm_holder_col_primary    = 200
@sltm_lvm_holder_col_merit      = 70
@sltm_lvm_holder_col_efficiency = 72
@sltm_lvm_holder_col_treasury   = 82
@sltm_lvm_holder_col_treasury_total = 88
@sltm_lvm_holder_col_strength   = 80
@sltm_lvm_holder_col_atwar      = 80
@sltm_lvm_holder_col_gap        = 4

# 国库管理页：六列总宽 978 + 5×4 间隔 = 998。
# R8.9：财政列采用三行固定节奏：存/入/净；低/常；目/上。
@sltm_lvm_treasury_row_height = 72
@sltm_lvm_treasury_col_identity = 220
@sltm_lvm_treasury_col_holder = 140
@sltm_lvm_treasury_col_private = 180
@sltm_lvm_treasury_col_treasury = 180
@sltm_lvm_treasury_col_budget = 178
@sltm_lvm_treasury_col_fixed_grant = 80
@sltm_lvm_treasury_col_gap = 4
# 已删列常量（注释保留备查）：
# @sltm_lvm_holder_col_titletype = 84
# @sltm_lvm_holder_col_skill     = 26
# 旧列常量（已删列，注释保留备查）：
# @sltm_lvm_holder_col_managed   = 64
# @sltm_lvm_holder_col_pending   = 58
# @sltm_lvm_holder_col_blocked   = 58

############################################################
# R10-35A2-4B3-CORRECT — 逐团实际维护费明细（保留已验证显示链路）。
# 输入：Scope.Regiment -> Regiment datacontext；只显示逐团费用，不参与总额聚合。
# TOTAL_MAA_COST / MAA_MAINTENANCE_SHORT 均为原版本地化，直接调用 Regiment getter。
############################################################
template sltm_lvm_treasury_maa_probe_regiment_row
{
    widget = {
        size = { 314 50 }
        datacontext = "[Scope.Regiment]"
        background = { using = Background_Area_Light alpha = 0.08 }
        vbox = {
            size = { 314 50 }
            spacing = 1
            hbox = {
                size = { 314 24 }
                icon = { size = { 22 22 } texture = "[Regiment.GetMAAType.GetIcon]" }
                text_single = { size = { 126 24 } text = "[Regiment.GetNameNoTooltip]" using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no elide = right }
                text_single = { size = { 66 24 } text = "[Regiment.BuildCurrentRegimentCountString|V]" using = Font_Size_Small align = right|nobaseline autoresize = no }
                text_single = { visible = "[Regiment.IsRaised]" size = { 74 24 } text = SLTM_LVM_TREASURY_MAA_RAISED using = Font_Size_Small default_format = "#N" align = right|nobaseline autoresize = no }
                text_single = { visible = "[Not(Regiment.IsRaised)]" size = { 74 24 } text = SLTM_LVM_TREASURY_MAA_UNRAISED using = Font_Size_Small default_format = "#low" align = right|nobaseline autoresize = no }
            }
            hbox = {
                size = { 314 24 }
                text_single = { size = { 66 24 } text = SLTM_LVM_TREASURY_MAA_ACTUAL_MAINTENANCE using = Font_Size_Small default_format = "#low" align = left|nobaseline autoresize = no }
                text_single = { size = { 248 24 } text = "TOTAL_MAA_COST" using = Font_Size_Small default_format = "#high" align = left|nobaseline autoresize = no tooltip = "TOTAL_MAA_COST_TOOLTIP" }
            }
        }
    }
}


############################################################
# R8-B2P4D22 — 俸禄预算：已验证中央支出公式，Tooltip 收口为正式说明。
############################################################
template sltm_lvm_budget_direct_salary_probe_tooltip
{
    widget = {
        alwaystransparent = no
        using = DefaultTooltipBackground
        vbox = {
            layoutpolicy_horizontal = expanding
            set_parent_size_to_minimum = yes
            margin = { 14 8 }
            spacing = 4
            textbox = {
                layoutpolicy_horizontal = expanding
                max_width = 560
                multiline = yes
                using = DefaultTooltipText
                text = SLTM_LVM_TREASURY_BUDGET_SALARY_TT
                fonttintcolor = "[TooltipInfo.GetTintColor]"
            }
        }
    }
}

