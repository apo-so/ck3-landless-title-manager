# ⚠ 2026-07-18（V3.5）本文件已被 ACS 全量迁移取代：封臣筛选六组现由
#   06_mytm_lvm_holder_filter_groups_acs.gui（ACS 分组+下拉）渲染，窗口不再实例化本文件的 type。
#   本文件保留备查（铁律：不删），其 type 定义无实例化时不渲染、无副作用。
# 无地头衔管理器 V2.7 —— 封臣筛选六个折叠分组（容器定义）
# 文件归属：GUI-FILTER（批次3 / 批次5），05 文件唯一创建 / 修改权
#
# 每个分组定义为一个本体 vbox type：
#   标题行 = button_expand（折叠/展开，切换 <组名>_open 旗标）+ 标题文本
#   内容容器 = vbox，visible 绑定 <组名>_open
# 普通枚举字段用 04 的 sltm_lvm_filter_row 组装：标签 + 当前值按钮 + 内部浮层
# 三态 token 用 button_standard（沿用现有 icon 模式：绿勾=必须具备 / 红叉=必须不具备）
#
# 铁律：不引用 acs_*；只引用本体资源（Background_DropDown / Scrollbar_Vertical 由 04 提供）
############################################################

types MytmLvmHolderFilterGroupTypes {

type sltm_lvm_holder_filter_group_manage = vbox {
    name = "sltm_lvm_holder_filter_group_manage"
    layoutpolicy_horizontal = expanding
    spacing = 2
    hbox = {
        layoutpolicy_horizontal = expanding
        margin_top = 2
        button_expand = {
            frame = "[Select_int32(GetVariableSystem.Exists('sltm_lvm_holder_filter_group_manage_open'), '(int32)2', '(int32)1')]"
            onclick = "[GetVariableSystem.Toggle('sltm_lvm_holder_filter_group_manage_open')]"
            tooltip = EXPAND_FILTER
            using = tooltip_ws
        }
        text_label_center = {
            layoutpolicy_horizontal = expanding
            margin_right = 36
            text = SLTM_LVM_FILTER_GROUP_MANAGE
            align = center
        }
    }
    vbox = {
        visible = "[GetVariableSystem.Exists('sltm_lvm_holder_filter_group_manage_open')]"
        layoutpolicy_horizontal = expanding
        spacing = 2
        margin_left = 12
        margin_right = 6
