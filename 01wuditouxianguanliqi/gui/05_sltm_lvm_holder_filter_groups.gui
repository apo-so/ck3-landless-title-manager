type sltm_lvm_holder_filter_group_trait_edu_genetic = vbox {
    name = "sltm_lvm_holder_filter_group_trait_edu_genetic"
    layoutpolicy_horizontal = expanding
    spacing = 2
    hbox = {
        layoutpolicy_horizontal = expanding
        margin_top = 2
        button_expand = {
            frame = "[Select_int32(GetVariableSystem.Exists('sltm_lvm_holder_filter_group_trait_edu_genetic_open'), '(int32)2', '(int32)1')]"
            onclick = "[GetVariableSystem.Toggle('sltm_lvm_holder_filter_group_trait_edu_genetic_open')]"
            tooltip = EXPAND_FILTER
            using = tooltip_ws
        }
        text_label_center = {
            layoutpolicy_horizontal = expanding
            margin_right = 36
            text = SLTM_LVM_FILTER_GROUP_TRAIT_EDU_GENETIC
            align = center
