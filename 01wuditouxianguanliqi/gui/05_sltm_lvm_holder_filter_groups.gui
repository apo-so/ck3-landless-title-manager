                    }
                    blockoverride "sltm_lvm_selected_action" {
                        onclick = "[GetVariableSystem.Set('sltm_lvm_dropdown_open', 'managed')]"
                        onclick = "[PdxGuiWidget.AccessParent.AccessParent.StackTop]"
                    }
                    blockoverride "sltm_lvm_selected_text" {
