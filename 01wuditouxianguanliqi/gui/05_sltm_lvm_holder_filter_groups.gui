    }
    vbox = {
        visible = "[GetVariableSystem.Exists('sltm_lvm_holder_filter_group_trait_edu_genetic_open')]"
        layoutpolicy_horizontal = expanding
        spacing = 2
        margin_left = 12
        margin_right = 6
